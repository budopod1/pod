%import parsing;
%import eval;
%import vals;

@value;
SourceRange {
    W:start_index,
    W:end_index
}

@super;
// @sealed;
PodArg {
    W:start_index,
    W:end_index
}

@super;
@extends PodArg;
// @sealed;
PodExpr {}

@extends PodExpr;
PodSExpr {
    [$PodArg]:args,
    PodSExpr?:pipeline
}

@extends PodExpr;
PodFnExpr {
    SourceFile:file,
    [PodSExpr]:lines,
    [$VMInstr]?:instrs,
}

@extends PodExpr;
PodVarExpr {
    Str:name
}

@extends PodExpr;
PodLiteralExpr {
    $PodVal:val
}

@extends PodArg;
PodSpreadArg {
    $PodExpr:expr
}

SourceRange#[$PodArg:arg].range {
    return SourceRange [arg.start_index, arg.end_index];
}
