%import eval;
%import vals;

@super;
// @sealed;
PodArg {}

@super;
@extends PodArg;
// @sealed;
PodExpr {}

@extends PodExpr;
PodSExpr {
    [$PodArg]:args,
    PodSExpr?:pipeline
}

@extends PodExpr;
PodFnExpr {
    [PodSExpr]:lines,
    [$VMInstr]?:instrs,
}

@extends PodExpr;
PodVarExpr {
    Str:name
}

@extends PodExpr;
PodLiteralExpr {
    $PodVal:val
}

@extends PodArg;
PodSpreadArg {
    $PodExpr:expr
}
