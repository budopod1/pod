%import pattern;
%import frames;
%import table;
%import eval;
%import vals;

$PodVal??#run datatype builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("str") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodStr [[args[0]].get_string];
    }

    ("symbol") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodSymbol [[args[0]].get_string];
    }

    ("float") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if [args[0]].matches[NumberPattern []] {
            return PodFloat [[args[0]] as float];
        };
        given args[0] as PodStr:str {
            given parse_float[str.val] as R:val {
                return PodFloat [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to float" % [args[0]].stringify_type;
        [stack].error["arg"][msg];
        return null#$PodVal?;
    }

    ("int") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if [args[0]].matches[IntPattern []] {
            return PodInt [[args[0]] as int];
        } elif [args[0]].matches[NumberPattern []] {
            return PodInt [[args[0]] as float#Z64];
        };
        given args[0] as PodStr:str {
            given parse_int[str.val] as Z64:val {
                return PodInt [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to int" % [args[0]].stringify_type;
        [stack].error["arg"][msg];
        return null#$PodVal?;
    }

    ("bool") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return pod bool [[args[0]].is_truthy];
    }

    ("arr") {
        return PodArray [args];
    }

    ("tbl") {
        require in [stack] [args] all match [EitherPattern [[$Pattern] [
            ArrayPattern [], PairPattern []
        ]]];
        if stack.active_error {return null#$PodVal?;};
        PodTable:tbl = make table;
        for $PodVal:arg in args {
            given arg as PodPair:pair {
                [tbl].put_pair[PodPair [pair.car, pair.cdr]];
            } given arg as PodArray:arr {
                if [arr.elems].len != 2 {
                    [stack].error["arg"]["Expected array of length 2"];
                    return null#$PodVal?;
                };
                [tbl].put_pair[PodPair [arr.elems[0], arr.elems[1]]];
            } else {
                abort;
            };
        };
        return tbl;
    }

    ("cons") {
        require in [stack] between [2] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodPair [args[0], args[1]];
    }

    ("list") {
        $PodVal:result = pod nil;
        for $PodVal:val in args step -1 {
            result = PodPair [val, result];
        };
        return result;
    }

    ("error") {
        require in [stack] between [1] and [3] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:type = [args[0]].get_string;
        Str?:msg = null;
        if [args].len >= 2 && args[1] != pod nil {
            require in [stack] [args[1]] matches [StringPattern []];
            if stack.active_error {return null#$PodVal?;};
            msg = [args[1]].get_string;
        };
        $PodVal?:data = null;
        if [args].len >= 3 {
            data = args[3];
        };
        return PodError [type, msg, data, null];
    }

    ("typestr") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodStr [[args[0]].stringify_type];
    }

    ("nilp") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return pod bool [args[0] == pod nil];
    }

    ("nil~p") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return pod bool [args[0] != pod nil];
    }

    {
        return null;
    };
}
