%import builtins.flow;
%import pattern;
%import frames;
%import eval;
%import vals;

@extends BuiltinFrameData;
SpreadBuiltinFrameData {
    [$PodVal]:elems
}

@extends BuiltinFrameData;
LenBuiltinFrameData {
    $PodVal:iter,
    Z64:count
}

@extends LoopBuiltinFrameData;
EachBuiltinFrameData {
    [$PodVal]:iters,
    $PodVal:body,
    Bool:ran_body,
    [$PodVal]:result
}

@extends LoopBuiltinFrameData;
ForBuiltinFrameData {
    $PodVal:iter,
    $PodVal:body,
    $PodVal?:else_
}

@extends BuiltinFrameData;
MapBuiltinFrameData {}

@extends BuiltinFrameData;
FilterBuiltinFrameData {
    $PodVal?:tested_car
}

@extends BuiltinFrameData;
ReduceBuiltinFrameData {
    $PodVal:iter,
    $PodVal:fn,
    $PodVal?:last,
    Bool:ran_body
}

@extends BuiltinFrameData;
EveryBuiltinFrameData {
    $PodVal:iter,
    $PodVal?:fn,
    Bool:ran_fn
}

@extends BuiltinFrameData;
IncludesBuiltinFrameData {
    $PodVal:haystack,
    $PodVal:needle
}

@extends BuiltinFrameData;
IdxBuiltinFrameData {
    $PodVal:iter,
    L:i
}

@extends BuiltinCaptureData;
RangeCaptureData {
    Z64:from,
    Z64?:to,
    Z64:step
}

@extends BuiltinCaptureData;
ArrayIterCaptureData {
    PodArray:arr,
    L:i
}

@extends BuiltinCaptureData;
MapCaptureData {
    [$PodVal]:iters,
    $PodVal:fn
}

@extends BuiltinCaptureData;
FilterCaptureData {
    $PodVal:iter,
    $PodVal:fn
}

@extends BuiltinCaptureData;
FlatCaptureData {
    $PodVal:superiter,
    $PodVal?:subiter
}

Bool#resolve iter [$PodVal:iter] in [PodStack:stack] {
    given iter as PodInt:int {
        return false;
    } given iter as PodNil:nil {
        return false;
    } given iter as PodPair:pair {
        return false;
    } given iter as PodArray:arr {
        return false;
    } given iter as PodIter:iter {
        if ![iter.lenp].is_null {
            return false;
        };
        PodBuiltinFn:fn = PodBuiltinFn ["#resolve-iter", null];
        $PodFrame:sub_frame = make frame in [stack]
            of [fn] args: [[$PodVal] [iter]];
        [stack.frames].append[sub_frame];
        return true;
    } else {
        Str:msg = "Expected iterable, got {}" % [iter].stringify_type;
        [stack].error["arg"][msg];
        return true;
    };
}

Bool#[$PodVal:iter].iter_lenp {
    given iter as PodInt:int {
        return int.val > 0;
    } given iter as PodNil:nil {
        return false;
    } given iter as PodPair:pair {
        return true;
    } given iter as PodArray:arr {
        return [arr.elems].len > 0;
    } given iter as PodIter:iter {
        return [iter.lenp]
            .expect["Expected iterable to be resolved"];
    } else {
        abort ["Expected an iterable"];
    };
}

$PodVal#[$PodVal:iter].iter_car {
    given iter as PodInt:int {
        return int;
    } given iter as PodNil:nil {
        return nil;
    } given iter as PodPair:pair {
        return pair.car;
    } given iter as PodArray:arr {
        return [arr.elems[0]?] || [pod nil];
    } given iter as PodIter:iter {
        Bool:lenp = [iter.lenp]
            .expect["Expected iterable to be resolved"];
        if lenp {
            return [iter.car_val].unwrap;
        } else {
            return pod nil;
        };
    } else {
        abort ["Expected an iterable"];
    };
}

$PodVal#[$PodVal:iter].iter_cdr {
    given iter as PodInt:int {
        if int.val > 0 {
            return PodInt [int.val - 1];
        } else {
            return int;
        };
    } given iter as PodNil:nil {
        return nil;
    } given iter as PodPair:pair {
        return pair.cdr;
    } given iter as PodArray:arr {
        return mkiter [PodBuiltinFn [
            "#array-iter", ArrayIterCaptureData [arr, 1]
        ]];
    } given iter as PodIter:iter {
        Bool:lenp = [iter.lenp]
            .expect["Expected iterable to be resolved"];
        if lenp {
            return [iter.cdr_val].unwrap;
        } else {
            return pod nil;
        };
    } else {
        abort ["Expected an iterable"];
    };
}

$PodVal??#iter cond builtin [BuiltinPodFrame:frame] in [PodStack:stack] every: [Bool:every] {
    EveryBuiltinFrameData?:maybe_data = null;
    given frame.data as EveryBuiltinFrameData:known_data {
        maybe_data = known_data;
    } else {
        [$PodVal]:args = frame.arg_vals;
        require in [stack] between [1] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        maybe_data = EveryBuiltinFrameData [args[0], args[1]?, false];
    };
    EveryBuiltinFrameData:data = [maybe_data].unwrap;
    if data.ran_fn {
        Bool:truth = [[frame.recieved].unwrap].is_truthy;
        if every != truth {
            return pod bool [truth];
        };
        data.ran_fn = false;
    };
    while true {
        frame.data = data;
        $PodVal:iter = data.iter;
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            return pod bool [every];
        };
        data.iter = [iter].iter_cdr;
        $PodVal:car = [iter].iter_car;
        given data.fn as $PodVal:fn {
            given make frame in [stack] of [fn] args: [[$PodVal] [car]]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            data.ran_fn = true;
            return null#$PodVal?;
        } else {
            Bool:truth = [car].is_truthy;
            if every != truth {
                return pod bool [truth];
            };
        };
    };
} 

$PodVal??#run iter builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("#spread") {
        $PodVal:iter = args[0];
        given iter as PodArray:iter_arr {
            return iter_arr;
        };
        [$PodVal]:elems = [$PodVal] [];
        given frame.data as SpreadBuiltinFrameData:frame_data {
            elems = frame_data.elems;
        } else {
            frame.data = SpreadBuiltinFrameData [elems];
        };
        while true {
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if [iter].iter_lenp {
                [elems].append[[iter].iter_car];
                iter = [iter].iter_cdr;
                args[0] = iter;
            } else {
                return PodArray [elems];
            };
        };
    }

    ("mkiter") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return mkiter [args[0]];
    }

    ("#resolve-iter") {
        PodIter:iter = [args[0]#PodIter?].unwrap;
        given frame.recieved as $PodVal:recieved {
            given recieved as PodNil:nil {
                iter.lenp = false;
            } given recieved as PodPair:pair {
                iter.lenp = true;
                iter.car_val = pair.car;
                iter.cdr_val = pair.cdr;
            } else {
                Str:msg = "Expected iterator to return pair or nil, got {}"
                    % [recieved].stringify_type;
                [stack].error["arg"][msg];
            };
            return pod nil;
        };
        $PodVal:_it = mkiter [iter.fn];
        given make frame in [stack]
            of [iter.fn] args: [[$PodVal] [_it]]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
            given sub_frame as $LexicalPodFrame:lexical_frame {
                set local var ["_it"] in [lexical_frame] to [_it];
            };
        };
        return null#$PodVal?;
    }

    ("#array-iter") {
        ArrayIterCaptureData:cap_data =
            [frame.builtin.data#ArrayIterCaptureData?].unwrap;
        L:i = cap_data.i;
        if i >= [cap_data.arr.elems].len {
            return pod nil;
        } else {
            cap_data.i += 1;
            return PodPair [cap_data.arr.elems[i], args[0]];
        };
    }
    
    ("lenp") { // returns whether a iterable is nonempty
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return pod bool [[args[0]].iter_lenp];
    }
    
    ("len~p") { // returns whether a iterable is empty
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return pod bool [![args[0]].iter_lenp];
    }

    ("len") {
        LenBuiltinFrameData?:maybe_data = null;
        given frame.data as LenBuiltinFrameData:known_data {
            maybe_data = known_data;
        } else {
            require in [stack] between [1] and [1] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                return PodInt [[[args[0]].get_string].len];
            };
            maybe_data = LenBuiltinFrameData [args[0], 0];
        };
        LenBuiltinFrameData:data = [maybe_data].unwrap;
        frame.data = data;
        while true {
            $PodVal:iter = data.iter;
            given iter as PodInt:int {
                return PodInt [data.count + int.val];
            } given iter as PodArray:arr {
                return PodInt [data.count + [arr.elems].len];
            };
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                return PodInt [data.count];
            };
            data.iter = [iter].iter_cdr;
            data.count += 1;
        };
    }

    ("car") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return [args[0]].iter_car;
    }

    ("cdr") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return [args[0]].iter_cdr;
    }

    ("both") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return PodArray [[$PodVal] [
            [args[0]].iter_car, [args[0]].iter_cdr
        ]];
    }

    ("#range") {
        RangeCaptureData:data = [builtin.data#RangeCaptureData?].unwrap;
        Bool:cont = true;
        given data.to as Z64:to {
            if data.step > 0 {
                cont = data.from < to;
            } else {
                cont = data.from > to;
            };
        };
        if cont {
            $PodVal:val = PodInt [data.from];
            data.from += data.step;
            return PodPair [val, args[0]];
        } else {
            return pod nil;
        };
    }

    ("range") {
        require in [stack] between [1] and [3] in [args];
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Z64:from = 0;
        Z64:to = 0;
        Z64:step = 1;
        if [args].len == 3 {
            from = [args[0]] as int;
            to = [args[1]] as int;
            step = [args[2]] as int;
        } elif [args].len == 2 {
            from = [args[0]] as int;
            to = [args[1]] as int;
        } elif [args].len == 1 {
            to = [args[0]] as int;
        };
        return mkiter [PodBuiltinFn [
            "#range", RangeCaptureData [from, to, step]
        ]];
    }

    ("count") {
        require in [stack] between [0] and [2] in [args];
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Z64:from = 0;
        Z64:step = 1;
        if [args].len >= 1 {
            from = [args[0]] as int;
        };
        if [args].len >= 2 {
            step = [args[1]] as int;
        };
        return mkiter [PodBuiltinFn [
            "#range", RangeCaptureData [from, null, step]
        ]];
    }

    ("each") {
        given frame.data as EachBuiltinFrameData:data {
            if data.ran_body {
                data.ran_body = false;
                if data.break_requested {
                    return PodArray [data.result];
                };
                if !data.continue_requested {
                    [data.result].append[[frame.recieved].unwrap];
                };
            };
            for $PodVal:iter in data.iters {
                if resolve iter [iter] in [stack] {return null#$PodVal?;};
                if ![iter].iter_lenp {
                    return PodArray [data.result];
                };
            };
            [$PodVal]:sub_args = [$PodVal] [];
            for L:i enumerating data.iters {
                $PodVal:iter = data.iters[i];
                [sub_args].append[[iter].iter_car];
                data.iters[i] = [iter].iter_cdr;
            };
            given make frame in [stack] of [data.body] args: [sub_args]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            data.ran_body = true;
            return null#$PodVal?;
        };
        require in [stack] between [2] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        [$PodVal]:iters = [args].slice[0][[args].len - 1];
        $PodVal:body = [args].at[-1];
        frame.data = EachBuiltinFrameData [
            false, false,
            iters, body, false, [$PodVal] []
        ];
        return null#$PodVal?;
    }

    ("for") {
        given frame.data as ForBuiltinFrameData:data {
            if data.break_requested {
                return [frame.recieved].unwrap;
            };
            $PodVal:iter = data.iter;
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                given data.else_ as $PodVal:else_ {
                    given make frame in [stack] of [else_]
                        args: [[$PodVal] []]
                    as $PodFrame:sub_frame {
                        replace top of [stack] with [sub_frame];
                    };
                    return null#$PodVal?;
                } else {
                    return pod nil;
                };
            };
            [$PodVal]:sub_args = [$PodVal] [[iter].iter_car];
            data.iter = [iter].iter_cdr;
            given make frame in [stack] of [data.body] args: [sub_args]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            return null#$PodVal?;
        };
        require in [stack] between [2] and [4] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal?:maybe_else = null;
        if [args].len >= 3 {
            require in [stack] [args[2]?] matches [ExactSymbolPattern ["else"]];
            if stack.active_error {return null#$PodVal?;};
            if [args].len < 4 {
                [stack].error["arg"]["Expected block after 'else'"];
                return null#$PodVal?;
            };
            maybe_else = args[3];
        };
        frame.data = ForBuiltinFrameData [
            false, false,
            args[0], args[1], maybe_else
        ];
        return null#$PodVal?;
    }

    ("#map") {
        given frame.data as MapBuiltinFrameData:frame_data {
            // frame data is only set once the mapping function is ran
            return PodPair [[frame.recieved].unwrap, args[0]];
        };
        MapCaptureData:cap_data = [builtin.data#MapCaptureData?].unwrap;
        for $PodVal:iter in cap_data.iters {
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                return pod nil;
            };
        };
        [$PodVal]:sub_args = [$PodVal] [];
        for L:i enumerating cap_data.iters {
            $PodVal:iter = cap_data.iters[i];
            [sub_args].append[[iter].iter_car];
            cap_data.iters[i] = [iter].iter_cdr;
        };
        given make frame in [stack] of [cap_data.fn] args: [sub_args]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        frame.data = MapBuiltinFrameData [];
        return null#$PodVal?;
    }

    ("map") {
        require in [stack] between [2] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal:fn = [args].at[-1];
        [$PodVal]:iters = [args].slice[0][[args].len - 1];
        return mkiter [PodBuiltinFn [
            "#map", MapCaptureData [iters, fn]
        ]];
    }

    ("#filter") {
        given frame.data as FilterBuiltinFrameData:frame_data {
            given frame_data.tested_car as $PodVal:result_car {
                if [[frame.recieved].unwrap].is_truthy {
                    return PodPair [result_car, args[0]];
                };
                frame_data.tested_car = null;
            };
        };
        FilterCaptureData:cap_data
            = [builtin.data#FilterCaptureData?].unwrap;
        $PodVal:iter = cap_data.iter;
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            return pod nil;
        };
        cap_data.iter = [iter].iter_cdr;
        $PodVal:car = [iter].iter_car;
        frame.data = FilterBuiltinFrameData [car];
        given make frame in [stack] of [cap_data.fn] args: [[$PodVal] [car]]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        return null#$PodVal?;
    }

    ("filter") {
        require in [stack] between [1] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal:iter = args[0];
        $PodVal:fn = [args[1]?] || [PodBuiltinFn ["bool", null]];
        return mkiter [PodBuiltinFn [
            "#filter", FilterCaptureData [iter, fn]
        ]];
    }

    ("reduce") {
        given frame.data as ReduceBuiltinFrameData:data {
            if data.ran_body {
                data.last = [frame.recieved].unwrap;
            };
            $PodVal:iter = data.iter;
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                given data.last as $PodVal:result {
                    return result;
                } else {
                    Str:msg = ["reduce with empty iterable and no "]
                        + ["initial value not allowed"];
                    [stack].error["arg"][msg];
                    return null#$PodVal?;
                };
            };
            $PodVal:car = [iter].iter_car;
            data.iter = [iter].iter_cdr;
            given data.last as $PodVal:last {
                given make frame in [stack] of [data.fn]
                    args: [[$PodVal] [last, car]]
                as $PodFrame:sub_frame {
                    [stack.frames].append[sub_frame];
                };
                data.ran_body = true;
                return null#$PodVal?;
            } else {
                data.last = car;
                return null#$PodVal?;
            };
            return null#$PodVal?;
        };
        require in [stack] between [2] and [3] in [args];
        if stack.active_error {return null#$PodVal?;};
        frame.data = ReduceBuiltinFrameData [
            args[0], args[1], args[2]?, false
        ];
        return null#$PodVal?;
    }

    ("some") {
        return iter cond builtin [frame] in [stack] every: [false];
    }

    ("every") {
        return iter cond builtin [frame] in [stack] every: [true];
    }

    ("includes") {
        IncludesBuiltinFrameData?:maybe_data = null;
        given frame.data as IncludesBuiltinFrameData:known_data {
            maybe_data = known_data;
        } else {
            require in [stack] between [2] and [2] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                require in [stack] [args[1]] matches [TxtPattern []];
                if stack.active_error {return null#$PodVal?;};
                Str:haystack = [args[0]].get_string;
                Str:needle = [args[1]].get_string;
                return pod bool[!![haystack].index_of[needle]];
            };
            maybe_data = IncludesBuiltinFrameData [args[0], args[1]];
        };
        IncludesBuiltinFrameData:data = [maybe_data].unwrap;
        frame.data = data;
        while true {
            $PodVal:iter = data.haystack;
            given iter as PodArray:arr {
                for $PodVal:elem in arr.elems {
                    if [elem] equals [data.needle] {
                        return pod bool [true];
                    };
                };
                return pod bool [false];
            };
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                return pod bool [false];
            } elif [[iter].iter_car] equals [data.needle] {
                return pod bool [true];
            };
            data.haystack = [iter].iter_cdr;
        };
    }

    ("idx") {
        IdxBuiltinFrameData?:maybe_data = null;
        given frame.data as IdxBuiltinFrameData:known_data {
            maybe_data = known_data;
        } else {
            require in [stack] between [2] and [2] in [args];
            require in [stack] [args[1]?] matches [IntPattern []];
            if stack.active_error {return null#$PodVal?;};
            Z64:signed_i = [args[1]] as int;
            if signed_i < 0 {
                [stack].error["idx"]["Index must be nonnegative"];
                return null#$PodVal?;
            };
            L:i = signed_i#L;
            if [args[0]].matches[TxtPattern []] {
                Str:str = [args[0]].get_string;
                given str[i]? as Byte:byte {
                    return PodStr [Str [byte]];
                } else {
                    [stack].error["idx"]["Index out of range"];
                    return null#$PodVal?;
                };
            };
            maybe_data = IdxBuiltinFrameData [args[0], i];
        };
        IdxBuiltinFrameData:data = [maybe_data].unwrap;
        frame.data = data;
        while true {
            $PodVal:iter = data.iter;
            given iter as PodArray:arr {
                given arr.elems[data.i]? as $PodVal:elem {
                    return elem;
                } else {
                    [stack].error["idx"]["Index out of range"];
                    return null#$PodVal?;
                };
            };
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                [stack].error["idx"]["Index out of range"];
                return null#$PodVal?;
            };
            if data.i == 0 {
                return [iter].iter_car;
            };
            data.i -= 1;
            data.iter = [iter].iter_cdr;
        };
    }

    ("reverse") {
        given frame.recieved as $PodVal:recieved {
            [$PodVal]:elems = [recieved#PodArray?].unwrap.elems;
            [$PodVal]:result = [$PodVal] [];
            for $PodVal:elem in elems step -1 {
                [result].append[elem];
            };
            return PodArray [result];
        };
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if [args[0]].matches[TxtPattern []] {
            Str:result = Str [];
            for Byte:byte in [args[0]].get_string step -1 {
                [result].append[byte];
            };
            return PodStr [result];
        } else {
            $PodFrame:sub_frame = make frame in [stack]
                of [PodBuiltinFn ["#spread", null]]
                args: [[$PodVal] [args[0]]];
            [stack.frames].append[sub_frame];
            return null#$PodVal?;
        };
    }

    ("#flat") {
        FlatCaptureData:data = [builtin.data#FlatCaptureData?].unwrap;
        while true {
            given data.subiter as $PodVal:subiter {
                if resolve iter [subiter] in [stack] {return null#$PodVal?;};
                if ![subiter].iter_lenp {
                    data.subiter = null;
                    continue;
                };
                data.subiter = [subiter].iter_cdr;
                return PodPair [[subiter].iter_car, args[0]];
            } else {
                if resolve iter [data.superiter] in [stack]
                    {return null#$PodVal?;};
                if ![data.superiter].iter_lenp {
                    return pod nil;
                };
                data.subiter = [data.superiter].iter_car;
                data.superiter = [data.superiter].iter_cdr;
            };
        };
    }

    ("flat") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return mkiter [PodBuiltinFn [
            "#flat", FlatCaptureData [args[0], null]
        ]];
    }

    {
        return null;
    };
}
