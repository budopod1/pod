%import builtins.flow;

%import runerrors;
%import pattern;
%import frames;
%import table;
%import eval;
%import vals;

@extends BuiltinFrameData;
SpreadFrameData {
    $PodVal:iter,
    [$PodVal]:elems
}

@extends BuiltinFrameData;
LenFrameData {
    $PodVal:iter,
    L:count
}

@extends LoopFrameData;
EachFrameData {
    [$PodVal]:iters,
    $PodVal:body,
    Bool:ran_body,
    [$PodVal]:result
}

@extends LoopFrameData;
ForFrameData {
    $PodVal:iter,
    $PodVal:body,
    $PodVal?:else_
}

@extends BuiltinFrameData;
MapFrameData {}

@extends BuiltinFrameData;
FilterFrameData {
    $PodVal?:tested_car
}

@extends BuiltinFrameData;
ReduceFrameData {
    $PodVal:iter,
    $PodVal:fn,
    $PodVal?:last,
    Bool:ran_body
}

@extends BuiltinFrameData;
EveryFrameData {
    $PodVal:iter,
    $PodVal?:fn,
    Bool:ran_fn
}

@extends BuiltinFrameData;
IncludesFrameData {
    $PodVal:haystack,
    $PodVal:needle
}

@extends BuiltinFrameData;
AtFrameData {
    $PodVal:iter,
    Z64:Zi,
    L?:i,
    SpreadFrameData?:spread_data
}

@extends BuiltinFrameData;
AtSliceFrameData {
    $PodVal:iter,
    IdxSlice:slice,
    AtFrameData?:start_at_data,
    AtFrameData?:end_at_data,
    L:offset,
    [$PodVal]:elems
}

@extends BuiltinFrameData;
IdxOfFrameData {
    $PodVal:haystack,
    $PodVal:needle,
    L:idx
}

@extends BuiltinCaptureData;
RangeCaptureData {
    Z64:from,
    Z64?:to,
    Z64:step
}

@extends BuiltinCaptureData;
ArrayIterCaptureData {
    PodArray:arr,
    L:i
}

@extends BuiltinCaptureData;
MapCaptureData {
    [$PodVal]:iters,
    $PodVal:fn
}

@extends BuiltinCaptureData;
FilterCaptureData {
    $PodVal:iter,
    $PodVal:fn
}

@extends BuiltinCaptureData;
SelectCaptureData {
    $PodVal:src,
    $PodVal:selector,
    $PodVal?:prev_iter,
    L?:prev_idx
}

@extends BuiltinCaptureData;
FlatCaptureData {
    $PodVal:superiter,
    $PodVal?:subiter
}

IdxSlice {
    Z64:start,
    Z64?:end
}

Bool#resolve iter [$PodVal:iter] in [PodStack:stack] {
    given iter as PodInt:int {
        return false;
    } given iter as PodNil:nil {
        return false;
    } given iter as PodPair:pair {
        return false;
    } given iter as PodArray:arr {
        return false;
    } given iter as PodIter:iter {
        if ![iter.lenp].is_null {
            return false;
        };
        PodBuiltinFn:fn = PodBuiltinFn ["#resolve-iter", null];
        $PodFrame:sub_frame = make frame in [stack]
            of [fn] args: [[$PodVal] [iter]];
        [stack.frames].append[sub_frame];
        return true;
    } else {
        Str:msg = "Expected iterable, got {}" % [iter].stringify_type;
        [stack].error["arg"][msg];
        return true;
    };
}

Bool#[$PodVal:iter].iter_lenp {
    given iter as PodInt:int {
        return int.val > 0;
    } given iter as PodNil:nil {
        return false;
    } given iter as PodPair:pair {
        return true;
    } given iter as PodArray:arr {
        return [arr.elems].len > 0;
    } given iter as PodIter:iter {
        return [iter.lenp]
            .expect["Expected iterable to be resolved"];
    } else {
        abort ["Expected an iterable"];
    };
}

$PodVal#[$PodVal:iter].iter_car {
    given iter as PodInt:int {
        return int;
    } given iter as PodNil:nil {
        return nil;
    } given iter as PodPair:pair {
        return pair.car;
    } given iter as PodArray:arr {
        return [arr.elems[0]?] || [pod nil];
    } given iter as PodIter:iter {
        Bool:lenp = [iter.lenp]
            .expect["Expected iterable to be resolved"];
        if lenp {
            return [iter.car_val].unwrap;
        } else {
            return pod nil;
        };
    } else {
        abort ["Expected an iterable"];
    };
}

$PodVal#[$PodVal:iter].iter_cdr {
    given iter as PodInt:int {
        if int.val > 0 {
            return PodInt [int.val - 1];
        } else {
            return int;
        };
    } given iter as PodNil:nil {
        return nil;
    } given iter as PodPair:pair {
        return pair.cdr;
    } given iter as PodArray:arr {
        return mkiter [PodBuiltinFn [
            "#array-iter", ArrayIterCaptureData [arr, 1]
        ]];
    } given iter as PodIter:iter {
        Bool:lenp = [iter.lenp]
            .expect["Expected iterable to be resolved"];
        if lenp {
            return [iter.cdr_val].unwrap;
        } else {
            return pod nil;
        };
    } else {
        abort ["Expected an iterable"];
    };
}

PodArray?#spread [SpreadFrameData:data] in [PodStack:stack] {
    $PodVal:iter = data.iter;
    given iter as PodArray:iter_arr {
        return iter_arr;
    };
    while true {
        if resolve iter [iter] in [stack] {return null;};
        if [iter].iter_lenp {
            [data.elems].append[[iter].iter_car];
            iter = [iter].iter_cdr;
            data.iter = iter;
        } else {
            return PodArray [data.elems];
        };
        if resolve iter [iter] in [stack] {return null;};
    };
}

L?#length [LenFrameData:data] in [PodStack:stack] {
    while true {
        $PodVal:iter = data.iter;
        given iter as PodInt:int {
            if int.val >= 1 {
                return data.count + int.val#L;
            } else {
                return data.count;
            };
        } given iter as PodArray:arr {
            return data.count + [arr.elems].len;
        };
        if resolve iter [iter] in [stack] {return null;};
        if ![iter].iter_lenp {
            return data.count;
        };
        data.iter = [iter].iter_cdr;
        data.count += 1;
        if check interrupt in [stack] {return null;};
    };
}

$PodVal??#iter cond builtin [BuiltinPodFrame:frame] in [PodStack:stack] every: [Bool:every] {
    EveryFrameData?:maybe_data = null;
    given frame.data as EveryFrameData:known_data {
        maybe_data = known_data;
    } else {
        [$PodVal]:args = frame.arg_vals;
        require in [stack] between [1] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        maybe_data = EveryFrameData [args[0], args[1]?, false];
    };
    EveryFrameData:data = [maybe_data].unwrap;
    if data.ran_fn {
        Bool:truth = [[frame.recieved].unwrap].is_truthy;
        if every != truth {
            return pod bool [truth];
        };
        data.ran_fn = false;
    };
    while true {
        frame.data = data;
        $PodVal:iter = data.iter;
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            return pod bool [every];
        };
        data.iter = [iter].iter_cdr;
        $PodVal:car = [iter].iter_car;
        given data.fn as $PodVal:fn {
            given make frame in [stack] of [fn] args: [[$PodVal] [car]]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            data.ran_fn = true;
            return null#$PodVal?;
        } else {
            Bool:truth = [car].is_truthy;
            if every != truth {
                return pod bool [truth];
            };
        };
        if check interrupt in [stack] {return null#$PodVal?;};
    };
}

IdxSlice?#parse slice [[$PodVal]:args] from [L:i] in [PodStack:stack] {
    Z64:start = 0;
    Z64?:end = null;
    $Pattern:dash_pattern = ExactSymbolPattern["-"];
    if [args[i]].matches[dash_pattern] {
        require in [stack] [args[i+1]] matches [IntPattern []];
        require in [stack] between [2+i] and [2+i] in [args];
        if stack.active_error {return null;};
        return IdxSlice [0, [args[i+1]] as int];
    } else {
        require in [stack] [args[i]] matches [IntPattern []];
        require in [stack] [args[i+1]] matches [dash_pattern];
        require in [stack] between [2+i] and [3+i] in [args];
        if stack.active_error {return null;};
        Z64:from = [args[i]] as int;
        if [args].len >= 3+i {
            require in [stack] [args[i+2]] matches [IntPattern []];
            if stack.active_error {return null;};
            return IdxSlice [from, [args[i+2]] as int];
        } else {
            return IdxSlice [from, null];
        };
    };
}

$PodVal?#init at [BuiltinPodFrame:frame] in [PodStack:stack] args: [[$PodVal]:args] {
    require in [stack] between [2] and [null] in [args];
    if stack.active_error {return null;};
    $PodVal:idxed = args[0];
    given idxed as PodTable:tbl {
        require in [stack] between [2] and [2] in [args];
        if stack.active_error {return null;};
        given [tbl].get_pair[args[1]] as PodPair:pair {
            return pair.cdr;
        } else {
            [stack].error["key"]["Key not found in table"];
            return null;
        };
    };
    if [args].len >= 3 {
        IdxSlice?:maybe_slice = parse slice [args] from [1] in [stack];
        if [maybe_slice].is_null {
            return null;
        };
        IdxSlice:slice = [maybe_slice].unwrap;
        frame.data = AtSliceFrameData [
            idxed, slice, null, null, 0, [$PodVal] []
        ];
    } else {
        require in [stack] [args[1]?] matches [IntPattern []];
        if stack.active_error {return null;};
        Z64:Zi = [args[1]] as int;
        frame.data = AtFrameData [idxed, Zi, null, null];
    };
    return null;
}

Bool#resolve at idx [AtFrameData:data] in [PodStack:stack] {
    while !data.i {
        if data.Zi >= 0 {
            data.i = data.Zi#L;
            break;
        };
        given data.iter as PodArray:arr {
            data.i = data.Zi#L + [arr.elems].len;
            break;
        };
        if !data.spread_data {
            data.spread_data = SpreadFrameData [data.iter, [$PodVal] []];
        };
        SpreadFrameData:spread_data
            = [data.spread_data#SpreadFrameData?].unwrap;
        given spread [spread_data] in [stack] as PodArray:arr {
            data.iter = arr;
            continue;
        } else {
            return true;
        };
    };
    return false;
}

$PodVal?#at [AtFrameData:data] in [PodStack:stack] {
    if [data.iter].matches[TxtPattern []] {
        Str:str = [data.iter].get_string;
        Z64:Zi = data.Zi;
        if Zi < 0 {
            Zi += [str].len;
        };
        if Zi < 0 || Zi >= [str].len {
            [stack].error["key"]["Index out of range"];
            return null;
        };
        return PodStr [Str [str[Zi]]];
    };

    if resolve at idx [data] in [stack] {return null;};

    while true {
        $PodVal:iter = data.iter;
        L:i = [data.i].unwrap;
        given iter as PodArray:arr {
            given arr.elems[i]? as $PodVal:elem {
                return elem;
            } else {
                [stack].error["key"]["Index out of range"];
                return null#$PodVal?;
            };
        };
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            [stack].error["key"]["Index out of range"];
            return null#$PodVal?;
        };
        if i == 0 {
            return [iter].iter_car;
        };
        data.i = i-1;
        data.iter = [iter].iter_cdr;
        if check interrupt in [stack] {return null#$PodVal?;};
    };
}

$PodVal?#at slice [AtSliceFrameData:data] in [PodStack:stack] {
    if [data.iter].matches[TxtPattern []] {
        Str:str = [data.iter].get_string;
        Z64:start = data.slice.start;
        if start < 0 {
            start += [str].len;
        };
        if start < 0 || start > [str].len {
            [stack].error["key"]["Index out of range"];
            return null;
        };
        Z64:end = [str].len;
        given data.slice.end as Z64:slice_end {
            if slice_end < 0 {
                end += slice_end;
            } else {
                end = slice_end;
            };
            if end < 0 || end > [str].len {
                [stack].error["key"]["Index out of range"];
                return null;
            };
        };
        if end < start {
            return PodStr [""];
        };
        return PodStr [[str].slice[start#L][end#L]];
    };

    if !data.start_at_data {
        data.start_at_data = AtFrameData [
            data.iter, data.slice.start, null, null
        ];
    };
    AtFrameData:start_at_data = [data.start_at_data].unwrap;
    if !start_at_data.i {
        if resolve at idx [start_at_data] in [stack] {return null;};
        data.iter = start_at_data.iter;
    };
    L:start_i = [start_at_data.i].unwrap;

    L?:maybe_end_i = null;
    given data.slice.end as Z64:slice_end {
        if !data.end_at_data {
            data.end_at_data = AtFrameData [
                data.iter, slice_end, null, null
            ];
        };
        AtFrameData:end_at_data = [data.end_at_data].unwrap;
        if !end_at_data.i {
            if resolve at idx [end_at_data] in [stack] {return null;};
            data.iter = end_at_data.iter;
            if start_i > [end_at_data.i].unwrap {
                [stack].error["key"]["Slice start must not be after end"];
                return null#$PodVal?;
            };
        };
        maybe_end_i = end_at_data.i;
    };

    given data.iter as PodArray:arr {
        given maybe_end_i as L:end_i {
            if end_i > [arr.elems].len {
                [stack].error["key"]["End index out of range"];
                return null#$PodVal?;
            };
            return PodArray [[arr.elems].slice[start_i][end_i]];
        } else {
            if start_i > [arr.elems].len {
                [stack].error["key"]["Start index out of range"];
                return null#$PodVal?;
            };
            return PodArray [[arr.elems].slice_from[start_i]];
        };
    };

    while true {
        $PodVal:iter = data.iter;
        L:offset = data.offset;
        given maybe_end_i as L:end_i {
            if end_i == offset {
                return PodArray [data.elems];
            };
        };
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            if maybe_end_i {
                [stack].error["key"]["End index out of range"];
                return null#$PodVal?;
            } else {
                return PodArray [data.elems];
            };
        };
        if offset >= start_i {
            [data.elems].append[[iter].iter_car];
        };
        data.offset = offset + 1;
        data.iter = [iter].iter_cdr;
        if check interrupt in [stack] {return null#$PodVal?;};
    };
}

$PodVal??#run iter builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("#spread") {
        if !frame.data {
            frame.data = SpreadFrameData [args[0], [$PodVal] []];
        };
        SpreadFrameData:data = [frame.data#SpreadFrameData?].unwrap;
        given spread [data] in [stack] as PodArray:arr {
            return arr;
        } else {
            return null#$PodVal?;
        };
    }

    ("mkiter") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return mkiter [args[0]];
    }

    ("#resolve-iter") {
        PodIter:iter = [args[0]#PodIter?].unwrap;
        given frame.recieved as $PodVal:recieved {
            given recieved as PodNil:nil {
                iter.lenp = false;
            } given recieved as PodPair:pair {
                iter.lenp = true;
                iter.car_val = pair.car;
                iter.cdr_val = pair.cdr;
            } else {
                Str:msg = "Expected iterator to return pair or nil, got {}"
                    % [recieved].stringify_type;
                [stack].error["arg"][msg];
            };
            return pod nil;
        };
        $PodVal:_it = mkiter [iter.fn];
        given make frame in [stack]
            of [iter.fn] args: [[$PodVal] [_it]]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
            given sub_frame as $LexicalPodFrame:lexical_frame {
                set local var ["_it"] in [lexical_frame] to [_it];
            };
        };
        return null#$PodVal?;
    }

    ("#array-iter") {
        ArrayIterCaptureData:cap_data =
            [frame.builtin.data#ArrayIterCaptureData?].unwrap;
        L:i = cap_data.i;
        if i >= [cap_data.arr.elems].len {
            return pod nil;
        } else {
            cap_data.i += 1;
            return PodPair [cap_data.arr.elems[i], args[0]];
        };
    }
    
    ("lenp") { // returns whether a iterable is nonempty
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return pod bool [[args[0]].iter_lenp];
    }
    
    ("len~p") { // returns whether a iterable is empty
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return pod bool [![args[0]].iter_lenp];
    }

    ("len") {
        if !frame.data {
            require in [stack] between [1] and [1] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                return PodInt [[[args[0]].get_string].len];
            };
            frame.data = LenFrameData [args[0], 0];
        };
        LenFrameData:data = [frame.data#LenFrameData?].unwrap;
        given length [data] in [stack] as L:len {
            return PodInt [len];
        } else {
            return null#$PodVal?;
        };
    }

    ("car") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return [args[0]].iter_car;
    }

    ("cdr") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return [args[0]].iter_cdr;
    }

    ("both") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        if resolve iter [args[0]] in [stack] {return null#$PodVal?;};
        return PodArray [[$PodVal] [
            [args[0]].iter_car, [args[0]].iter_cdr
        ]];
    }

    ("#range") {
        RangeCaptureData:data = [builtin.data#RangeCaptureData?].unwrap;
        Bool:cont = true;
        given data.to as Z64:to {
            if data.step > 0 {
                cont = data.from < to;
            } else {
                cont = data.from > to;
            };
        };
        if cont {
            $PodVal:val = PodInt [data.from];
            data.from += data.step;
            return PodPair [val, args[0]];
        } else {
            return pod nil;
        };
    }

    ("range") {
        require in [stack] between [1] and [3] in [args];
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Z64:from = 0;
        Z64:to = 0;
        Z64:step = 1;
        if [args].len == 3 {
            from = [args[0]] as int;
            to = [args[1]] as int;
            step = [args[2]] as int;
        } elif [args].len == 2 {
            from = [args[0]] as int;
            to = [args[1]] as int;
        } elif [args].len == 1 {
            to = [args[0]] as int;
        };
        return mkiter [PodBuiltinFn [
            "#range", RangeCaptureData [from, to, step]
        ]];
    }

    ("count") {
        require in [stack] between [0] and [2] in [args];
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Z64:from = 0;
        Z64:step = 1;
        if [args].len >= 1 {
            from = [args[0]] as int;
        };
        if [args].len >= 2 {
            step = [args[1]] as int;
        };
        return mkiter [PodBuiltinFn [
            "#range", RangeCaptureData [from, null, step]
        ]];
    }

    ("each") {
        given frame.data as EachFrameData:data {
            if data.ran_body {
                data.ran_body = false;
                if data.break_requested {
                    return PodArray [data.result];
                };
                if !data.continue_requested {
                    [data.result].append[[frame.recieved].unwrap];
                };
            };
            for $PodVal:iter in data.iters {
                if resolve iter [iter] in [stack] {return null#$PodVal?;};
                if ![iter].iter_lenp {
                    return PodArray [data.result];
                };
            };
            [$PodVal]:sub_args = [$PodVal] [];
            for L:i enumerating data.iters {
                $PodVal:iter = data.iters[i];
                [sub_args].append[[iter].iter_car];
                data.iters[i] = [iter].iter_cdr;
            };
            given make frame in [stack] of [data.body] args: [sub_args]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            data.ran_body = true;
            return null#$PodVal?;
        };
        require in [stack] between [2] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        [$PodVal]:iters = [args].slice[0][[args].len - 1];
        $PodVal:body = [args].at[-1];
        frame.data = EachFrameData [
            false, false,
            iters, body, false, [$PodVal] []
        ];
        return null#$PodVal?;
    }

    ("for") {
        given frame.data as ForFrameData:data {
            if data.break_requested {
                return [frame.recieved].unwrap;
            };
            $PodVal:iter = data.iter;
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                given data.else_ as $PodVal:else_ {
                    given make frame in [stack] of [else_]
                        args: [[$PodVal] []]
                    as $PodFrame:sub_frame {
                        replace top of [stack] with [sub_frame];
                    };
                    return null#$PodVal?;
                } else {
                    return pod nil;
                };
            };
            [$PodVal]:sub_args = [$PodVal] [[iter].iter_car];
            data.iter = [iter].iter_cdr;
            given make frame in [stack] of [data.body] args: [sub_args]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            return null#$PodVal?;
        };
        require in [stack] between [2] and [4] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal?:maybe_else = null;
        if [args].len >= 3 {
            require in [stack] [args[2]?] matches [ExactSymbolPattern ["else"]];
            if stack.active_error {return null#$PodVal?;};
            if [args].len < 4 {
                [stack].error["arg"]["Expected block after 'else'"];
                return null#$PodVal?;
            };
            maybe_else = args[3];
        };
        frame.data = ForFrameData [
            false, false,
            args[0], args[1], maybe_else
        ];
        return null#$PodVal?;
    }

    ("#map") {
        given frame.data as MapFrameData:frame_data {
            // frame data is only set once the mapping function is ran
            return PodPair [[frame.recieved].unwrap, args[0]];
        };
        MapCaptureData:cap_data = [builtin.data#MapCaptureData?].unwrap;
        for $PodVal:iter in cap_data.iters {
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                return pod nil;
            };
        };
        [$PodVal]:sub_args = [$PodVal] [];
        for L:i enumerating cap_data.iters {
            $PodVal:iter = cap_data.iters[i];
            [sub_args].append[[iter].iter_car];
            cap_data.iters[i] = [iter].iter_cdr;
        };
        given make frame in [stack] of [cap_data.fn] args: [sub_args]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        frame.data = MapFrameData [];
        return null#$PodVal?;
    }

    ("map") {
        require in [stack] between [2] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal:fn = [args].at[-1];
        [$PodVal]:iters = [args].slice[0][[args].len - 1];
        return mkiter [PodBuiltinFn [
            "#map", MapCaptureData [iters, fn]
        ]];
    }

    ("#filter") {
        given frame.data as FilterFrameData:frame_data {
            given frame_data.tested_car as $PodVal:result_car {
                if [[frame.recieved].unwrap].is_truthy {
                    return PodPair [result_car, args[0]];
                };
                frame_data.tested_car = null;
            };
        };
        FilterCaptureData:cap_data
            = [builtin.data#FilterCaptureData?].unwrap;
        $PodVal:iter = cap_data.iter;
        if resolve iter [iter] in [stack] {return null#$PodVal?;};
        if ![iter].iter_lenp {
            return pod nil;
        };
        cap_data.iter = [iter].iter_cdr;
        $PodVal:car = [iter].iter_car;
        frame.data = FilterFrameData [car];
        given make frame in [stack] of [cap_data.fn] args: [[$PodVal] [car]]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        return null#$PodVal?;
    }

    ("filter") {
        require in [stack] between [1] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        $PodVal:iter = args[0];
        $PodVal:fn = [args[1]?] || [PodBuiltinFn ["bool", null]];
        return mkiter [PodBuiltinFn [
            "#filter", FilterCaptureData [iter, fn]
        ]];
    }

    ("reduce") {
        given frame.data as ReduceFrameData:data {
            if data.ran_body {
                data.last = [frame.recieved].unwrap;
            };
            $PodVal:iter = data.iter;
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                given data.last as $PodVal:result {
                    return result;
                } else {
                    Str:msg = ["reduce with empty iterable and no "]
                        + ["initial value not allowed"];
                    [stack].error["arg"][msg];
                    return null#$PodVal?;
                };
            };
            $PodVal:car = [iter].iter_car;
            data.iter = [iter].iter_cdr;
            given data.last as $PodVal:last {
                given make frame in [stack] of [data.fn]
                    args: [[$PodVal] [last, car]]
                as $PodFrame:sub_frame {
                    [stack.frames].append[sub_frame];
                };
                data.ran_body = true;
                return null#$PodVal?;
            } else {
                data.last = car;
                return null#$PodVal?;
            };
            return null#$PodVal?;
        };
        require in [stack] between [2] and [3] in [args];
        if stack.active_error {return null#$PodVal?;};
        frame.data = ReduceFrameData [
            args[0], args[1], args[2]?, false
        ];
        return null#$PodVal?;
    }

    ("some") {
        return iter cond builtin [frame] in [stack] every: [false];
    }

    ("every") {
        return iter cond builtin [frame] in [stack] every: [true];
    }

    ("includes") {
        IncludesFrameData?:maybe_data = null;
        given frame.data as IncludesFrameData:known_data {
            maybe_data = known_data;
        } else {
            require in [stack] between [2] and [2] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                require in [stack] [args[1]] matches [TxtPattern []];
                if stack.active_error {return null#$PodVal?;};
                Str:haystack = [args[0]].get_string;
                Str:needle = [args[1]].get_string;
                return pod bool[!![haystack].index_of[needle]];
            };
            maybe_data = IncludesFrameData [args[0], args[1]];
        };
        IncludesFrameData:data = [maybe_data].unwrap;
        frame.data = data;
        while true {
            $PodVal:iter = data.haystack;
            given iter as PodArray:arr {
                for $PodVal:elem in arr.elems {
                    if [elem] equals [data.needle] {
                        return pod bool [true];
                    };
                };
                return pod bool [false];
            };
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                return pod bool [false];
            } elif [[iter].iter_car] equals [data.needle] {
                return pod bool [true];
            };
            data.haystack = [iter].iter_cdr;
            if check interrupt in [stack] {return null#$PodVal?;};
        };
    }

    ("@") {
        if !frame.data {
            given init at [frame] in [stack] args: [args]
            as $PodVal:immediate_result {
                return immediate_result;
            };
            if stack.active_error {return null#$PodVal?;};
        };

        given frame.data as AtFrameData:at_data {
            given at [at_data] in [stack] as $PodVal:result {
                return result;
            };
        } given frame.data as AtSliceFrameData:at_slice_data {
            given at slice [at_slice_data] in [stack] as $PodVal:result {
                return result;
            };
        } else {
            abort;
        };
        return null#$PodVal?;
    }

    ("#select") {
        SelectCaptureData:cap_data
            = [builtin.data#SelectCaptureData?].unwrap;

        given frame.data as AtFrameData:at_data {
            given at [at_data] in [stack] as $PodVal:result {
                if cap_data.prev_idx {
                    cap_data.prev_iter = at_data.iter;
                };
                return PodPair [result, args[0]];
            } else {
                return null#$PodVal?;
            };
        };

        $PodVal:selector = cap_data.selector;
        if resolve iter [selector] in [stack] {return null#$PodVal?;};
        if ![selector].iter_lenp {
            return pod nil;
        };
        cap_data.selector = [selector].iter_cdr;
        $PodVal:key = [selector].iter_car;
        given cap_data.src as PodTable:tbl {
            given [tbl].get_pair[key] as PodPair:pair {
                return PodPair [pair.cdr, args[0]];
            } else {
                [stack].error["key"]["Key not found in table"];
                return null#$PodVal?;
            };
        };
        given key as PodInt:key_int {
            $PodVal:src_iter = cap_data.src;
            Z64:idx = key_int.val;
            AtFrameData:at_data = AtFrameData [
                cap_data.src, idx, null, null
            ];
            frame.data = at_data;
            given cap_data.prev_idx as L:prev_idx {
                if idx >= prev_idx {
                    at_data.iter = [cap_data.prev_iter].unwrap;
                    at_data.Zi -= prev_idx;
                };
            };
            if idx > 0 {
                cap_data.prev_idx = idx#L;
            } else {
                cap_data.prev_idx = null;
            };
        } else {
            [stack].error["key"]["Key must be integer"];
        };
        return null#$PodVal?;
    }

    ("select") {
        require in [stack] between [2] and [2] in [args];
        if stack.active_error {return null#$PodVal?;};
        return mkiter [PodBuiltinFn [
            "#select", SelectCaptureData [args[0], args[1], null, null]
        ]];
    }

    ("reverse") {
        if !frame.data {
            require in [stack] between [1] and [1] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                Str:result = Str [];
                for Byte:byte in [args[0]].get_string step -1 {
                    [result].append[byte];
                };
                return PodStr [result];
            } else {
                frame.data = SpreadFrameData [args[0], [$PodVal] []];
            };
        };
        SpreadFrameData:data = [frame.data#SpreadFrameData?].unwrap;
        given spread [data] in [stack] as PodArray:arr {
            [$PodVal]:result = [$PodVal] [];
            for $PodVal:elem in arr.elems step -1 {
                [result].append[elem];
            };
            return PodArray [result];
        } else {
            return null#$PodVal?;
        };
    }

    ("#flat") {
        FlatCaptureData:data = [builtin.data#FlatCaptureData?].unwrap;
        while true {
            given data.subiter as $PodVal:subiter {
                if resolve iter [subiter] in [stack] {return null#$PodVal?;};
                if ![subiter].iter_lenp {
                    data.subiter = null;
                    continue;
                };
                data.subiter = [subiter].iter_cdr;
                return PodPair [[subiter].iter_car, args[0]];
            } else {
                if resolve iter [data.superiter] in [stack]
                    {return null#$PodVal?;};
                if ![data.superiter].iter_lenp {
                    return pod nil;
                };
                data.subiter = [data.superiter].iter_car;
                data.superiter = [data.superiter].iter_cdr;
            };
            if check interrupt in [stack] {return null#$PodVal?;};
        };
    }

    ("flat") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return mkiter [PodBuiltinFn [
            "#flat", FlatCaptureData [args[0], null]
        ]];
    }

    ("idxof") {
        if !frame.data {
            require in [stack] between [2] and [2] in [args];
            if stack.active_error {return null#$PodVal?;};
            if [args[0]].matches[TxtPattern []] {
                require in [stack] [args[1]] matches [TxtPattern []];
                if stack.active_error {return null#$PodVal?;};
                Str:haystack = [args[0]].get_string;
                Str:needle = [args[1]].get_string;
                given [haystack].index_of[needle] as L:idx {
                    return PodInt [idx];
                } else {
                    [stack].error["key"]["Substring not found in string"];
                    return null#$PodVal?;
                };
            };
            frame.data = IdxOfFrameData [args[0], args[1], 0];
        };

        IdxOfFrameData:data = [frame.data#IdxOfFrameData?].unwrap;
        while true {
            $PodVal:iter = data.haystack;
            given iter as PodArray:arr {
                for L:j enumerating arr.elems {
                    if [arr.elems[j]] equals [data.needle] {
                        return PodInt [data.idx + j];
                    };
                };
                break;
            };
            if resolve iter [iter] in [stack] {return null#$PodVal?;};
            if ![iter].iter_lenp {
                break;
            };
            if [[iter].iter_car] equals [data.needle] {
                return PodInt [data.idx];
            };
            data.haystack = [iter].iter_cdr;
            data.idx += 1;
            if check interrupt in [stack] {return null#$PodVal?;};
        };
        [stack].error["key"]["Key not found for specified value"];
        return null#$PodVal?;
    }

    {
        return null;
    };
}
