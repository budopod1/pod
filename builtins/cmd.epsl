%import platform;
%import pattern;
%import podproc;
%import subproc;
%import iotools;
%import frames;
%import paths;
%import eval;
%import vals;

@extends PodOpaque;
PodCaptureStatus {
    Str:var_name
}

Str?#extract status cap name in [[$PodVal]:args] {
    for L:i enumerating args step -1 {
        $PodVal:arg = args[i];
        given arg as PodCaptureStatus:cap_status {
            [args].pop[i];
            return cap_status.var_name;
        };
    };
    return null;
}

Bool#check status [PodProcess:pod_proc] cap: [Str?:cap_name] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    given cap_name as Str:var_name {
        set var [var_name]
            in [top lexical frame in [stack]]
            to [PodInt [proc.result_status]];
    } else {
        if proc.result_status != 0 {
            Str:msg = "process '{}' exited with status {}"
                % proc.program % proc.result_status;
            [stack].error["cmd"][msg];
            return true;
        };
    };
    return false;
}

$PodVal??#run cmd builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("wherecmd") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:name = [args[0]].get_string;
        given lookup [name] in PATH as Str:result {
            return PodStr [result];
        } else {
            return pod nil;
        };
    }

    ("cmd") {
        Str?:cap_name = extract status cap name in [args];
        given start proc with [args] in [stack] as PodProcess:proc {
            if wait for_ [proc] completion in [stack] {
                return null#$PodVal?;
            };
            if check status [proc] cap: [cap_name] in [stack] {
                return null#$PodVal?;
            };
            given get proc out [proc] in [stack] as Str:out {
                return PodStr [out];
            } else {
                return pod nil;
            };
        };
        return null#$PodVal?;
    }

    ("proc") {
        given start proc with [args] in [stack] as PodProcess:proc {
            return proc;
        };
        return null#$PodVal?;
    }

    ("glob") {
        require in [stack] [args] all match [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        [Str]:patterns = [Str] [];
        for $PodVal:val in args {
            Path:path = pod expand path [[val].get_string];
            [patterns].append[[path].stringify];
        };
        [$PodVal]:elems = [$PodVal] [];
        for Str:match in glob_paths[patterns] {
            [elems].append[PodStr [match]];
        };
        return PodArray [elems];
    }

    ("getpid") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        if stack.active_error {return null#$PodVal?;};
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        return PodInt [proc.proc.pid];
    }

    ("getstatus") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        if stack.active_error {return null#$PodVal?;};
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        if poll proc [proc] in [stack] {
            return null#$PodVal?;
        };
        if proc.proc.completed {
            return PodInt [proc.proc.result_status];
        } else {
            return pod nil;
        };
    }
    
    ("getout") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        if stack.active_error {return null#$PodVal?;};
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        given get proc out [proc] in [stack] as Str:out {
            return PodStr [out];
        } else {
            return pod nil;
        };
    }

    ("sendin") {
        require in [stack] between [2] and [2] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        require in [stack] [args[1]] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        Str:txt = [args[1]].get_string;
        send input [txt] to proc [proc] in [stack];
        return pod nil;
    }

    ("wait") {
        Str?:cap_name = extract status cap name in [args];
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        if stack.active_error {return null#$PodVal?;};
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        wait for_ [proc] completion in [stack];
        check status [proc] cap: [cap_name] in [stack];
        return pod nil;
    }

    ("signalproc") {
        require in [stack] between [1] and [2] in [args];
        require in [stack] [args[0]] matches [OpaquePattern ["process"]];
        if stack.active_error {return null#$PodVal?;};
        Str:signame = "SIGKILL";
        if [args].len >= 2 {
            require in [stack] [args[1]] matches [TxtPattern []];
            if stack.active_error {return null#$PodVal?;};
            signame = [args[1]].get_string;
        };
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        send signal [signame] to [proc] in [stack];
        return pod nil;
    }

    ("env") {
        require in [stack] between [2] and [2] in [args];
        require in [stack] [args[0]] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        return PodEnvVar [
            "env-var",
            args[0],
            args[1]
        ];
    }

    ("capstatus") {
        require in [stack] between [0] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        Str:var_name = "_";
        if args {
            require in [stack] [args[0]] matches [SymbolPattern []];
            if stack.active_error {return null#$PodVal?;};
            var_name = [args[0]].get_string;
        };
        return PodCaptureStatus ["capture-status", var_name];
    }

    ("cmdor") {
        given frame.recieved as $PodVal:recieved {
            return recieved;
        };

        given [frame].consume_error as PodError:error {
            if ![error.type] equals ["cmd"] {
                [stack].error[error];
                return null#$PodVal?;
            };
        };

        if !args {
            return pod nil;
        };

        frame.landing = ErrorLanding [null];

        given make frame in [stack] of [[args].pop[0]] args: [[$PodVal] []]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        return null#$PodVal?;
    }
    
    {
        return null;
    };
}
