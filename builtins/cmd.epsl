%import platform;
%import pattern;
%import podproc;
%import subproc;
%import iotools;
%import frames;
%import paths;
%import eval;
%import vals;

@extends PodOpaque;
PodCaptureStatus {
    Str:var_name
}

Str?#extract status cap name in [[$PodVal]:args] {
    for L:i enumerating args step -1 {
        $PodVal:arg = args[i];
        given arg as PodCaptureStatus:cap_status {
            [args].pop[i];
            return cap_status.var_name;
        };
    };
    return null;
}

#check status [PodProcess:pod_proc] cap: [Str?:cap_name] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    given cap_name as Str:var_name {
        set var [var_name]
            in [top lexical frame in [stack]]
            to [PodInt [proc.result_status]];
    } else {
        if proc.result_status != 0 {
            Str:msg = "process '{}' exited with status {}"
                % proc.program % proc.result_status;
            temp error msg: [msg];
        };
    };
}

$PodVal??#run cmd builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("wherecmd") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:name = [args[0]].get_string;
        given lookup [name] in PATH as Str:result {
            return PodStr [result];
        } else {
            return pod nil;
        };
    }

    ("cmd") {
        Str?:cap_name = extract status cap name in [args];
        given start proc with [args] in [stack] as PodProcess:proc {
            wait for_ [proc] completion;
            check status [proc] cap: [cap_name] in [stack];
            return pod nil;
        };
        return null;
    }

    ("proc") {
        given start proc with [args] in [stack] as PodProcess:proc {
            return proc;
        };
        return null;
    }

    ("glob") {
        require [args] all match [TxtPattern []];
        [Str]:patterns = [Str] [];
        for $PodVal:val in args {
            Path:path = pod expand path [[val].get_string];
            [patterns].append[[path].stringify];
        };
        [$PodVal]:elems = [$PodVal] [];
        for Str:match in glob_paths[patterns] {
            [elems].append[PodStr [match]];
        };
        return PodArray [elems];
    }

    ("getstatus") {
        require between [1] and [1] in [args];
        require [args[0]] matches [OpaquePattern ["process"]];
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        poll proc [proc];
        if proc.proc.completed {
            return PodInt [proc.proc.result_status];
        } else {
            return pod nil;
        };
    }

    ("wait") {
        Str?:cap_name = extract status cap name in [args];
        require between [1] and [1] in [args];
        require [args[0]] matches [OpaquePattern ["process"]];
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        wait for_ [proc] completion;
        check status [proc] cap: [cap_name] in [stack];
        return pod nil;
    }

    ("signalproc") {
        require between [1] and [2] in [args];
        require [args[0]] matches [OpaquePattern ["process"]];
        Str:signame = "SIGKILL";
        if [args].len >= 2 {
            require [args[1]] matches [TxtPattern []];
            signame = [args[1]].get_string;
        };
        PodProcess:proc = [args[0]#PodProcess?].unwrap;
        send signal [signame] to [proc];
        return pod nil;
    }

    ("env") {
        require between [2] and [2] in [args];
        require [args[0]] matches [TxtPattern []];
        return PodEnvVar [
            "env-var",
            args[0],
            args[1]
        ];
    }

    ("capstatus") {
        require between [1] and [1] in [args];
        require [args[0]] matches [SymbolPattern []];
        return PodCaptureStatus [
            "capture-status",
            [args[0]].get_string
        ];
    }
    
    {
        return null;
    };
}
