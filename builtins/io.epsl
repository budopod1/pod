%import inputline;
%import pattern;
%import frames;
%import eval;
%import vals;
%import proc;
%import time;

@extends BuiltinData;
TimeBuiltinData {
    R:start_time
}

$PodVal??#run io builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("print") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        println[result];
        return pod nil;
    }

    ("inputline") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        return PodStr [inputline[result]];
    }
    
    ("getenv") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        given get env var [[args[0]].get_string] as Str:val {
            return PodStr [val];
        } else {
            return pod nil;
        };
    }

    ("setenv") {
        require between [2] and [2] in [args];
        require [args] all match [TxtPattern []];
        Bool:status = set env var [[args[0]].get_string]
            to [[args[1]].get_string];
        return pod bool [status];
    }

    ("unsetenv") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Bool:status = unset env var [[args[0]].get_string];
        return pod bool [status];
    }

    ("time") {
        given frame.data as TimeBuiltinData:data {
            R:elapsed = read perf counter - data.start_time;
            Str:msg = "\nelapsed    {}m{}s\n"
                % (elapsed#W ~/ 60) % (elapsed % 60);
            print[msg];
            return [frame.recieved].unwrap;
        };
        require between [1] and [null] in [args];
        frame.data = TimeBuiltinData [read perf counter];
        $PodFrame:sub_frame = make frame in [stack]
            of [args[0]] args: [[args].slice_from[1]];
        [stack.frames].append[sub_frame];
        return null#$PodVal?;
    }
    
    ("exit") {
        require between [0] and [1] in [args];
        Z:status = 0;
        if args {
            require [args[0]] matches [IntPattern []];
            status = [args[0]] as int#Z;
        };
        exit with status [status];
        abort;
    }

    {
        return null;
    };
}
