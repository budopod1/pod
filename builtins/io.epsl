%import inputline;
%import pattern;
%import iotools;
%import frames;
%import paths;
%import eval;
%import vals;
%import proc;
%import time;

@extends BuiltinData;
TimeBuiltinData {
    R:start_time
}

$PodVal??#run io builtin [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    switch builtin.name
    ("print") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        println[result];
        return pod nil;
    }

    ("inputline") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        return PodStr [inputline[result]];
    }

    ("promptoptions") {
        require in [stack] between [2] and [null] in [args];
        require in [stack] [args] all match [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        for L:i enumerating args from 1 {
            println["{}) {}" % i % [args[i]].get_string];
        };
        while true {
            Str:reply = inputline[[args[0]].get_string];
            given parse_int[reply] as Z:num {
                if num > 1 || num < [args].len {
                    return args[num];
                };
            };
            println["Invalid option {}" % reply];
        };
    }
    
    ("getenv") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        given get env var [[args[0]].get_string] as Str:val {
            return PodStr [val];
        } else {
            return pod nil;
        };
    }

    ("setenv") {
        require in [stack] between [2] and [2] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Bool:status = set env var [[args[0]].get_string]
            to [[args[1]].get_string];
        return pod bool [status];
    }

    ("unsetenv") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Bool:status = unset env var [[args[0]].get_string];
        return pod bool [status];
    }

    ("time") {
        given frame.data as TimeBuiltinData:data {
            R:elapsed = read perf counter - data.start_time;
            Str:msg = "\nelapsed    {}m{}s\n"
                % (elapsed#W ~/ 60) % (elapsed % 60);
            print[msg];
            return [frame.recieved].unwrap;
        };
        require in [stack] between [1] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        frame.data = TimeBuiltinData [read perf counter];
        given make frame in [stack] of [args[0]]
            args: [[args].slice_from[1]]
        as $PodFrame:sub_frame {
            [stack.frames].append[sub_frame];
        };
        return null#$PodVal?;
    }

    ("unixtime") {
        return PodFloat [get unix timestamp];
    }

    ("perfcounter") {
        return PodFloat [read perf counter];
    }
    
    ("exit") {
        require in [stack] between [0] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        Z:status = 0;
        if args {
            require in [stack] [args[0]] matches [IntPattern []];
            if stack.active_error {return null#$PodVal?;};
            status = [args[0]] as int#Z;
        };
        exit with status [status];
        abort;
    }

    ("ep") { // expand path
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:str = [args[0]].get_string;
        return PodStr [[pod expand path [str]].stringify];
    }

    ("fileext") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = Path_from [[args[0]].get_string];
        return PodStr [[path].extension];
    }

    ("filestem") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = Path_from [[args[0]].get_string];
        return PodStr [[path].stem];
    }

    ("cwd") {
        given cwd_Path as Path:cwd {
            return PodStr [[pod expand path [cwd]].stringify];
        } else {
            [stack].error["io"]["Cannot determine cwd"];
            return null#$PodVal?;
        };
    }

    ("cd") {
        require in [stack] between [0] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        Str:pathstr = "~";
        if args {
            require in [stack] [args[0]] matches [TxtPattern []];
            if stack.active_error {return null#$PodVal?;};
            pathstr = [args[0]].get_string;
        };
        Path:path = pod expand path [pathstr];
        if ![path].cd_to {
            [stack].error["io"]["Cannot cd to {}" % [path].stringify];
            return null#$PodVal?;
        };
        return pod nil;
    }

    ("absp") { // absolute?
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = [Path_from [[args[0]].get_string]].expand_user;
        return pod bool [[path].is_absolute];
    }

    ("existsp") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = [Path_from [[args[0]].get_string]].expand_user;
        return pod bool [[path].exists];
    }

    ("filep") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = [Path_from [[args[0]].get_string]].expand_user;
        return pod bool [[path].is_file];
    }

    ("dirp") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = [Path_from [[args[0]].get_string]].expand_user;
        return pod bool [[path].is_dir];
    }

    ("symlinkp") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:path = [Path_from [[args[0]].get_string]].expand_user;
        return pod bool [[path].is_symlink];
    }

    ("readdir") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Path:dir = [Path_from [[args[0]].get_string]].expand_user;
        given [dir].dir_items as [Str]:items {
            [$PodVal]:elems = [$PodVal] [];
            for Str:item in items {
                if ([item] equals ["."]) || ([item] equals [".."]) {
                    continue;
                };
                Str:str = [[dir] / [item]].stringify;
                [elems].append[PodStr [str]];
            };
            return PodArray [elems];
        } else {
            return pod nil;
        };
    }
    
    {
        return null;
    };
}
