%import runerrors;
%import platform;
%import builtins;
%import frames;
%import vals;
%import proc;
%import ast;

@super;
VMInstr {}

@extends VMInstr;
LiteralVMInstr {
    $PodVal:val
}

@extends VMInstr;
VarVMInstr {
    Str:name
}

@extends VMInstr;
MakeFnVMInstr {
    PodFnExpr:src
}

@extends VMInstr;
CallFnVMInstr {
    SourceRange:src_range,
    W:arg_count,
    [W]:spread_args
}

@extends VMInstr;
PipeVMInstr {
    W:dest_target
}

@extends VMInstr;
PipeEndVMInstr {
    Bool:is_child
}

FrameRunResult {
    $PodVal?:ret_val,
    PodError?:error
}

@extends FrameCtx;
RedirectionCtx {
    Z64:target,
    Z64:old_fd
}

@extends FrameCtx;
ForkChildCtx {}

@extends FrameCtx;
DeferredCtx {
    $PodFn:fn
}

@extends BuiltinFrameData;
DeferredFrameData {
    $PodFn:fn,
    PodError?:error
}

#[RedirectionCtx:redirect_ctx].exit stack: [PodStack:stack] {
    restore_std_fd[redirect_ctx.target][redirect_ctx.old_fd];
}

#[ForkChildCtx:child_ctx].exit stack: [PodStack:stack] {
    given stack.active_error as PodError:error {
        display error [error];
    };
    exit with status [0];
}

#[DeferredCtx:deferred_ctx].exit stack: [PodStack:stack] {
    PodBuiltinFn:fn = PodBuiltinFn ["#deferred", null];
    BuiltinPodFrame:frame = make builtin frame [fn] args: [[$PodVal] []];
    frame.data = DeferredFrameData [deferred_ctx.fn, null];
    frame.landing = ErrorLanding [null];
    [stack.frames].append[frame];
}

#compile expr [$PodExpr:expr] to [[$VMInstr]:instrs] {
    given expr as PodLiteralExpr:literal_expr {
        [instrs].append[LiteralVMInstr [literal_expr.val]];
    } given expr as PodVarExpr:var_expr {
        [instrs].append[VarVMInstr [var_expr.name]];
    } given expr as PodFnExpr:fn_expr {
        [instrs].append[MakeFnVMInstr [fn_expr]];
    } given expr as PodSExpr:sexpr {
        compile sexpr [sexpr] to [instrs];
    } else {
        abort;
    };
}

#compile sexpr [PodSExpr:sexpr] to [[$VMInstr]:instrs] {
    PipeVMInstr?:maybe_pipe_instr = null;
    if sexpr.pipeline {
        PipeVMInstr:pipe_instr = PipeVMInstr [0];
        [instrs].append[pipe_instr];
        maybe_pipe_instr = pipe_instr;
    };
    [W]:spread_args = [W] [];
    for W:i enumerating sexpr.args {
        $PodArg:arg = sexpr.args[i];
        given arg as $PodExpr:expr {
            compile expr [expr] to [instrs];
        } given arg as PodSpreadArg:spread_arg {
            [instrs].append[LiteralVMInstr [
                PodBuiltinFn ["#spread", null]
            ]];
            compile expr [spread_arg.expr] to [instrs];
            [instrs].append[CallFnVMInstr [[arg].range, 2, [W] []]];
            [spread_args].append[i];
        } else {
            abort;
        };
    };
    [instrs].append[CallFnVMInstr [
        [sexpr].range, [sexpr.args].len#W, spread_args
    ]];
    given sexpr.pipeline as PodSExpr:pipe_dest {
        [instrs].append[PipeEndVMInstr [true]];
        [maybe_pipe_instr].unwrap.dest_target = [instrs].len#W;
        compile sexpr [pipe_dest] to [instrs];
        [instrs].append[PipeEndVMInstr [false]];
    };
}

[$VMInstr]#compile fn [PodClearFn:fn] {
    PodFnExpr:src = fn.src;
    given src.instrs as [$VMInstr]:known_instrs {
        return known_instrs;
    };
    [$VMInstr]:instrs = [$VMInstr] [];
    for PodSExpr:line in src.lines {
        compile sexpr [line] to [instrs];
    };
    src.instrs = instrs;
    return instrs;
}

$PodFrame#make frame in [PodStack:stack] of [$PodFn:fn] args: [[$PodVal]:args] {
    $PodFrame?:maybe_frame = null;
    given fn as PodClearFn:clear_fn {
        maybe_frame = make clear frame [clear_fn] args: [args];
    } given fn as PodBuiltinFn:builtin_fn {
        maybe_frame = make builtin frame [builtin_fn] args: [args];
    } else {
        abort;
    };

    return [maybe_frame].unwrap;
}

$PodFrame?#make frame in [PodStack:stack] using [[$PodVal]:args] {
    if !args {
        [stack].error["arg"]["at least one argument is required"];
        return null;
    };
    
    return make frame in [stack] of [args[0]] args: [[args].slice_from[1]];
}

$PodFrame?#make frame in [PodStack:stack] of [$PodVal:fn_val] args: [[$PodVal]:args] {
    $PodFn?:maybe_fn = null;
    given fn_val as $PodFn:fn {
        maybe_fn = fn;
    } given fn_val as PodSymbol:sym {
        given lookup registered fn [sym.str] in [stack] as $PodFn:fn {
            maybe_fn = fn;
        } else {
            return make frame in [stack]
                of [PodBuiltinFn ["cmd", null]]
                args: [[[$PodVal] [fn_val]] + [args]];
        };
    } else {
        [stack].error["arg"]["cannot execute {}" % [fn_val].stringify_type];
        return null;
    };

    $PodFn:fn = [maybe_fn].unwrap;
    return make frame in [stack] of [fn] args: [args];
}

#execute [$VMInstr:instr] on [ClearFnPodFrame:clear_frame] in [PodStack:stack] {
    [$PodVal]:val_stack = clear_frame.val_stack;
    clear_frame.src_range = null;
    given instr as LiteralVMInstr:literal_instr {
        [val_stack].append[literal_instr.val];
    } given instr as VarVMInstr:var_instr {
        given lookup [var_instr.name] in [clear_frame] in [stack] as $PodVal:val {
            [val_stack].append[val];
        };
    } given instr as MakeFnVMInstr:make_fn_instr {
        [val_stack].append[
            PodClearFn [make_fn_instr.src, clear_frame]
        ];
    } given instr as CallFnVMInstr:call_fn_instr {
        clear_frame.src_range = call_fn_instr.src_range;

        W:arg_count = call_fn_instr.arg_count;

        [$PodVal]:expanded_vals = [$PodVal] [];
        for W:i to arg_count {
            $PodVal:val = val_stack[[val_stack].len - arg_count + i];
            if [call_fn_instr.spread_args].index_of[i] {
                PodArray:arr = [val#PodArray?]
                    .expect["Spread value should be array"];
                [expanded_vals].extend[arr.elems];
            } else {
                [expanded_vals].append[val];
            };
        };

        for W:i to arg_count {
            [val_stack].pop_end;
        };

        given make frame in [stack] using [expanded_vals]
        as $PodFrame:frame {
            [stack.frames].append[frame];
        };
    } given instr as PipeVMInstr:pipe_instr {
        PipePair:pipe = make_pipe_pair;
        if fork_proc {
            close_fd[pipe.in];
            swap_std_fd[1][pipe.out];
            [clear_frame.ctxs].append[ForkChildCtx []];
        } else {
            close_fd[pipe.out];
            Z64:old_stdin = swap_std_fd[0][pipe.in];
            [clear_frame.ctxs].append[RedirectionCtx [0, old_stdin]];
            clear_frame.pc = pipe_instr.dest_target;
        };
    } given instr as PipeEndVMInstr:pipe_end_instr {
        [[clear_frame.ctxs].pop_end].exit stack: [stack];
    } else {
        abort ["Unrecognized VM instruction {}" % instr];
    };
}

Bool#check interrupt in [PodStack:stack] {
    if consume_interrupt_request {
        [stack].error["int"]["Keyboard interrupt"];
        return true;
    };
    return false;
}

Bool#run cycle in [PodStack:stack] {
    check interrupt in [stack];

    $PodFrame:frame = [stack.frames].at[-1];
    given stack.active_error as PodError:active_error {
        given frame.landing as ErrorLanding:landing {
            landing.caught_error = active_error;
            stack.active_error = null;
        } else {
            pop frame in [stack];
        };
        return false;
    };

    given frame as ClearFnPodFrame:clear_frame {
        given clear_frame.recieved as $PodVal:recieved {
            [clear_frame.val_stack].append[recieved];
        };

        [$VMInstr]:instrs = compile fn [clear_frame.fn];
        W:pc = clear_frame.pc;

        if pc >= [instrs].len {
            $PodVal:ret_val = pod nil;
            if clear_frame.val_stack {  
                ret_val = [clear_frame.val_stack].pop_end;
            };
            pop frame in [stack] returning [ret_val];
            return false;
        };

        $VMInstr:instr = instrs[pc];
        pc += 1;
        clear_frame.pc = pc;

        execute [instr] on [clear_frame] in [stack];
    } given frame as BuiltinPodFrame:builtin_frame {
        $PodVal?:maybe_ret = builtin cycle of [builtin_frame] in [stack];
        if stack.active_error {
            return false;
        };
        given maybe_ret as $PodVal:ret {
            pop frame in [stack] returning [ret];
        };
    } given frame as RootPodFrame:root_frame {
        return true;
    } else {
        abort ["Cannot run cycle in frame {}" % frame];
    };

    frame.recieved = null;
    return false;
}

FrameRunResult#run frame [$PodFrame:frame] in [PodStack:stack] {
    $PodFrame:top_frame = [stack.frames].at[-1];
    if !(top_frame#RootPodFrame?) {
        abort ["Cannot run new frame above non root frame"];
    };
    ErrorLanding:landing = [top_frame.landing].unwrap;
    [stack.frames].append[frame];

    while !run cycle in [stack] {};

    given [top_frame].consume_error as PodError:error {
        return FrameRunResult [null, error];
    };

    $PodVal:ret_val = [top_frame.recieved].unwrap;
    top_frame.recieved = null;
    return FrameRunResult [ret_val, null];
}
