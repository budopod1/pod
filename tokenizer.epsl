TokenDataResult#parse_int_token [Str:txt] {
    Z64:val = [txt].parse_as_Z64;
    return TokenDataResult [IntTokenData [val], null];
}

TokenDataResult#parse_float_token [Str:txt] {
    given parse_float [txt] as R:val {
        return TokenDataResult [FloatTokenData [val], null];
    } else {
        return TokenDataResult [null, TokenizationError [
            "Invalid float", 0
        ]];
    };
}

TokenDataResult#parse_base_int_token [Str:txt] {
    Bool:is_negative = txt[0] == '-';
    W:i = 0;
    if is_negative {
        i += 1;
    };
    if txt[i] != '0' {
        return TokenDataResult [null, TokenizationError [
            "Expected '0' here in integer with special base", i
        ]];
    };
    i += 1; // skip the intial zero
    if i >= [txt].len - 1 {
        return TokenDataResult [null, TokenizationError [
            "Expected complete integer literal", [txt].len#W - 1
        ]];
    };

    Byte:base_id = txt[i];
    W:base = 0;
    if base_id == 'b' {
        base = 2;
    } elif base_id == 'o' {
        base = 8;
    } elif base_id == 'x' {
        base = 16;
    } else {
        return TokenDataResult [null, TokenizationError [
            "Expected 'b', 'o', or 'x'", i
        ]];
    };
    i += 1;
    
    Z64:result = 0;
    for W:j enumerating txt from i {
        Byte:byte = txt[j];
        W:digit_value = 0;
        if [byte].is_digit {
            digit_value = byte - '0';
        } elif [byte].is_hex_digit { // should be in "abcdefABCDEF"
            digit_value = ([byte] & [31]) + 9;
        } else {
            return TokenDataResult [null, TokenizationError [
                "Invalid digit '{}'" % byte, j
            ]];
        };
        if digit_value >= base {
            return TokenDataResult [null, TokenizationError [
                "Digit with value {} not allowed in base {} literal"
                    % digit_value % base, j
            ]];
        };
        result *= base;
        result += digit_value;
    };

    if is_negative {
        result *= -1;
    };

    return TokenDataResult [IntTokenData [result], null];
}

TokenizationResult#tokenize [Str:input] {
    Tokens:tokens = new_Tokens_at[0];
    [TokenizationError]:errors = [TokenizationError] [];

    /*
    parse state:
    0 - standard
    1 - string
    2 - string, was backslash
    REMOVED 3 - byte
    REMOVED 4 - byte, was backslash
    5 - line comment
    6 - block comment
    7 - int
    8 - float
    9 - symbol
    NEW 10 - standard, was backslash
    NEW 11 - integer with base != 10
    */
    W:parse_state = 0;

    Str:so_far = [""].clone;
    W:token_start = 0;

    W:index = 0;
    while index < [input].len {
        Bool:is_end = index == [input].len-1;
        Byte:byte = input[index];
        switch parse_state
        (0) {
            if [byte].is_ignored {

            } elif byte == '"' || byte == '\'' {
                parse_state = 1;
                token_start = index;
                so_far = Str [];
            } elif (byte == '-' && !is_end && [input[index+1]].is_digit)
                || [byte].is_digit {
                parse_state = 7;
                token_start = index;
                index -= 1;
                so_far = Str [];
            } elif byte == '#' {
                parse_state = 5;
            } elif byte == '/' && !is_end && input[index+1] == '*' {
                parse_state = 6;
            } elif [byte].is_symbol_start {
                parse_state = 9;
                token_start = index;
                index -= 1;
                so_far = Str [];
            } elif byte == '\\' {
                parse_state = 10;
            } else {
                [tokens.ids].append[byte];
                [tokens.start_indexes].append[index];
                [tokens.end_indexes].append[index];
                [tokens.data].append[null];
            };
        }
        (1) {
            if byte == input[token_start] {
                [tokens.ids].append[T_STR];
                [tokens.start_indexes].append[token_start];
                [tokens.end_indexes].append[index];
                TokenDataResult:data_result = parse_string_token [so_far];
                given data_result.error as TokenizationError:error {
                    error.index += token_start+1; // +1 because of leading "
                    [errors].append[error];
                };
                [tokens.data].append[data_result.data];
                parse_state = 0;
            } else {
                if byte == '\\' {
                    parse_state = 2;
                };
                [so_far].append[byte];
            };
        }
        (2) {
            [so_far].append[byte];
            parse_state = 1;
        }
//         (3) {
//             if byte == '\'' {
//                 [tokens.ids].append[T_BYTE];
//                 [tokens.start_indexes].append[token_start];
//                 [tokens.end_indexes].append[index];
//                 TokenDataResult:data_result = parse_byte_token [so_far];
//                 given data_result.error as TokenizationError:error {
//                     error.index += token_start+1; // +1 because of leading '
//                     [errors].append[error];
//                 };
//                 [tokens.data].append[data_result.data];
//                 parse_state = 0;
//             } else {
//                 if byte == '\\' {
//                     parse_state = 4;
//                 };
//                 [so_far].append[byte];
//             };
//         }
//         (4) {
//             [so_far].append[byte];
//             parse_state = 3;
//         }
        (5) {
            if byte == '\n' {
                parse_state = 0;
            };
        }
        (6) {
            if byte == '/' && input[index-1] == '*' {
                parse_state = 0;
            };
        }
        (7) {
            Bool:is_num_end = is_end;
            if [byte].is_digit || (!so_far && byte == '-') {
                [so_far].append[byte];
            } elif [byte].is_base_id {
                is_num_end = false;
                index -= 1;
                parse_state = 11;
            } elif byte == '.' {
                is_num_end = false;
                index -= 1;
                parse_state = 8;
            } elif [byte].is_symbol {
                is_num_end = false;
                parse_state = 9;
                index -= 1;
            } else {
                is_num_end = true;
                parse_state = 0;
                index -= 1;
            };
            if is_num_end {
                [tokens.ids].append[T_INT];
                [tokens.start_indexes].append[token_start];
                [tokens.end_indexes].append[index];
                TokenDataResult:data_result = parse_int_token [so_far];
                given data_result.error as TokenizationError:error {
                    error.index += token_start;
                    [errors].append[error];
                };
                [tokens.data].append[data_result.data];
            };
        }
        (8) {
            Bool:is_num_end = is_end;
            if ([byte].is_digit)
                || (byte == '.' && (![so_far].index_of['.'])) {
                [so_far].append[byte];
            } elif [byte].is_symbol {
                is_num_end = false;
                parse_state = 9;
                index -= 1;
            } else {
                is_num_end = true;
                parse_state = 0;
                index -= 1;
            };
            if is_num_end {
                [tokens.ids].append[T_FLOAT];
                [tokens.start_indexes].append[token_start];
                [tokens.end_indexes].append[index];
                TokenDataResult:data_result = parse_float_token [so_far];
                given data_result.error as TokenizationError:error {
                    error.index += token_start;
                    [errors].append[error];
                };
                [tokens.data].append[data_result.data];
            };
        }
        (9) {
            Bool:is_symbol_end = is_end;
            if [byte].is_symbol {
                [so_far].append[byte];
            } else {
                is_symbol_end = true;
                parse_state = 0;
                index -= 1;
            };
            if is_symbol_end {
                [tokens.ids].append[T_SYM];
                [tokens.start_indexes].append[token_start];
                [tokens.end_indexes].append[index];
                [tokens.data].append[SymbolTokenData [so_far]];
            };
        }
        (10) {
            if byte != '\n' {
                [errors].append[TokenizationError [
                    "Unexpected character after '\\'", index
                ]];
            };
            parse_state = 0;
        }
        (11) {
            Bool:is_num_end = is_end;
            if ([byte].is_hex_digit) || ([byte].is_base_id) {
                [so_far].append[byte];
            } else {
                is_num_end = true;
                parse_state = 0;
                index -= 1;
            };
            if is_num_end {
                [tokens.ids].append[T_INT];
                [tokens.start_indexes].append[token_start];
                [tokens.end_indexes].append[index];
                TokenDataResult:data_result = parse_base_int_token [so_far];
                given data_result.error as TokenizationError:error {
                    error.index += token_start;
                    [errors].append[error];
                };
                [tokens.data].append[data_result.data];
            };
        }
        {abort;};
        index += 1;
    };

    if parse_state == 1 || parse_state == 2 {
        [errors].append[TokenizationError [
            "Unterminated string literal", [input].len#W - 1
        ]];
    };
    if parse_state == 3 || parse_state == 4 {
        [errors].append[TokenizationError [
            "Unterminated byte literal", [input].len#W - 1
        ]];
    };

    return TokenizationResult [tokens, errors];
}

Tokens#new_Tokens_at[W:start_index] {
    return Tokens [start_index, [W] [], [W] [], [W] [], [$TokenData?] []];
}

#[Tokens:dest].add_from[Tokens:src][L:i] {
    [dest.ids].append[src.ids[i]];
    [dest.start_indexes].append[src.start_indexes[i]];
    [dest.end_indexes].append[src.end_indexes[i]];
    [dest.data].append[src.data[i]];
}

Str#[$TokenData?:data].read_symbol {
    given data as SymbolTokenData:symbol_data {
        return symbol_data.val;
    } else {
        abort ["The given token data is not symbol data"];
    };
}

Str#[$TokenData?:data].read_string {
    given data as StrTokenData:string_data {
        return string_data.val;
    } else {
        abort ["The given token data is not string data"];
    };
}

Tokens#[$TokenData?:data].read_group {
    given data as GroupTokenData:group_data {
        return group_data.sub;
    } else {
        abort ["The given token data is not group data"];
    };
}

Str#token_id_to_name[W:id] {
    if id == '\n' {
        return "newline";
    } elif id < 32 || id == 127 {
        return "unprintable ASCII character (code {})" % id;
    } elif id < 127 {
        return "'{}'" % id#Byte;
    };
    switch id
    (300) {return "symbol";}
    (301) {return "integer literal";}
    (302) {return "float literal";}
    (303) {return "byte literal";}
    (304) {return "string literal";}
    (400) {return "parenthesis group";}
//     (401) {return "square bracket group";}
    (402) {return "curly bracket group";}
    {
        abort ["Invalid token ID {}" % id];
    };
}

Str#[Tokens:tokens].stringify {
    Str:result = ["Tokens("].clone;
    for (L:i enumerating tokens.ids) {
        W:id = tokens.ids[i];
        $TokenData?:data = tokens.data[i];
        if id < 128 {
            [result].append[id#Byte];
        } elif id == T_SYM {
            [result].extend[" {} " % [data].read_symbol];
        } elif id == T_PAREN_GROUP/* || id == T_SQUARE_GROUP*/ || id == T_CURLY_GROUP {
            [result].extend["[{}]({})" % token_id_to_name[id] % [[data].read_group].stringify];
        } else {
            [result].extend["[{}]" % token_id_to_name[id]];
        };
    };
    [result].append[')'];
    return result;
}
