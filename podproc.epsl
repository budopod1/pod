%import runerrors;
%import platform;
%import pattern;
%import iotools;
%import subproc;
%import frames;
%import paths;
%import vals;
%import eval;

@extends PodOpaque;
PodEnvVar {
    $PodVal:var_name,
    $PodVal:var_val
}

@extends PodOpaque;
PodProcess {
    Process:proc
}

Str#[$PodVal:val].cmd_stringify {
    given val as PodArray:array {
        Str:result = [""].clone;
        for $PodVal:elem in array.elems {
            if result {
                [result].append['\0'];
            };
            [result].extend[[elem].get_string];
        };
        return result;
    };
    return [val].get_string;
}

Str?#lookup redirect file [Str:str] in [PodStack:stack] {
    if str[0] == '$' {
        Str:name = [str].slice_from[1];
        given lookup [name] in [top lexical frame in [stack]] in [stack]
        as $PodVal:val {
            if ![val].matches[TxtPattern []] {
                Str:msg = "expected string or symbol for redirect path";
                [stack].error["cmd"][msg];
                return null;
            };
            return [val].get_string;
        } else {
            return null;
        };
    } else {
        return str;
    };
}

ProcOutputRedirect?#make output redirection from [Str:str] in [PodStack:stack] {
    if [str] equals [".."] {
        // pipe
        return ProcOutputRedirect [3, null];
    } elif [str] equals ["."] {
        // pipe, strip final newline
        return ProcOutputRedirect [5, null];
    } elif [str] equals ["&1"] {
        // redirect to stdout
        return ProcOutputRedirect [1, null];
    } elif [str] equals ["&2"] {
        // redirect to stderr
        return ProcOutputRedirect [2, null];
    } elif !str {
        [stack].error["cmd"]["expected redirection target"];
        return null;
    } else {
        given lookup redirect file [str] in [stack] as Str:file {
            return ProcOutputRedirect [4, file];
        } else {
            return null;
        };
    };
}

ProcInputRedirect?#make input redirection from [Str:str] in [PodStack:stack] {
    if [str] equals ["."] {
        // pipe
        return ProcInputRedirect [1, null];
    } elif !str {
        [stack].error["cmd"]["expected redirection target"];
        return null;
    } else {
        given lookup redirect file [str] in [stack] as Str:file {
            return ProcInputRedirect [2, file];
        } else {
            return null;
        };
    };
}

Bool#process cmd symbol arg [Str:str] on [ProcInitInfo:init] in [PodStack:stack] {
    // the target, coming after the '>', can be:
    // 1 (redirect to stdout)
    // 2 (redirect to stderr)
    // . (capture as result)
    // .. (capture as result, strip final newline)
    // $.* (get the variable's value, repeat this selection)
    // .* (redirect to file)
    if str[0]? == '>' || str[1]? == '>' {
        L:off_idx = 1 + (str[0] != '>');
        ProcOutputRedirect?:maybe_redirect = make output redirection
            from [[str].slice_from[off_idx]] in [stack];
        if !maybe_redirect {
            return true;
        };
        ProcOutputRedirect:redirect = [maybe_redirect].unwrap;
        if redirect.mode == 5 {
            redirect.mode = 3;
            init.out_strip_final_newline = true;
        };
        switch str[0]
        ('>') {
            init.stdout_dest = redirect;
        }
        ('1') {
            init.stdout_dest = redirect;
        }
        ('2') {
            init.stderr_dest = redirect;
        }
        ('&') {
            init.stdout_dest = redirect;
            init.stderr_dest = redirect;
        }
        {
            Str:msg = "cannot make redirection from '{}'" % str[0];
            [stack].error["cmd"][msg];
            return true;
        };
    } elif str[0]? == '<' {
        given make input redirection from [[str].slice_from[1]] in [stack]
        as ProcInputRedirect:redirect {
            init.stdin_src = redirect;
        } else {
            return true;
        };
    } elif ([str].index_of["*"]) || ([str].index_of["?"])
        || ([str].index_of["["]) || (str[0]? == '~') {
        Str:path_str = [pod expand path [str]].stringify;
        [init.args].extend[glob_paths[[Str] [path_str]]];
    } else {
        [init.args].append[str];
    };
    return false;
}

#[ProcError:proc_err].raise[PodStack:stack] {
    [stack].error["cmd"][proc_err.msg];
}

Bool#[ProcError?:maybe_err].maybe_raise[PodStack:stack] {
    given maybe_err as ProcError:proc_err {
        [proc_err].raise[stack];
        return true;
    };
    return false;
}

PodProcess?#start proc with [[$PodVal]:args] in [PodStack:stack] {
    ProcInitInfo:init = ProcInitInfo [
        ProcInputRedirect [0, null],  // stdin_src
        ProcOutputRedirect [0, null], // stdout_dest
        ProcOutputRedirect [0, null], // stderr_dest
        false,                        // out_strip_final_newline
        [ProcEnvVal] [],              // env_vals
        "",                           // program
        [Str] []                      // args
    ];

    for $PodVal:arg in args {
        given arg as PodNil:nil {
            continue;
        } given arg as PodEnvVar:pod_env_var {
            [init.env_vals].append[ProcEnvVal [
                [pod_env_var.var_name].get_string,
                [pod_env_var.var_val].get_string
            ]];
            continue;
        } given arg as PodSymbol:symbol {
            if process cmd symbol arg [symbol.str] on [init] in [stack] {
                return null;
            };
            continue;
        };
        [init.args].append[[arg].cmd_stringify];
    };

    if !init.args {
        [stack].error["cmd"]["program name not specified"];
        return null;
    };
    
    init.program = init.args[0];
    ProcessResult:proc_result = start_proc [init];

    given proc_result.maybe_process as Process:proc {
        return PodProcess ["process", proc];
    } given proc_result.maybe_error as ProcError:error {
        [error].raise[stack];
        return null;
    } else {
        abort ["Invalid ProcessResult without Process or ProcError"];
    };
}

Bool#wait for_ [PodProcess:pod_proc] completion in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    if proc.completed {
        return false;
    };
    return [await_proc_completion[proc]].maybe_raise[stack];
}

Str?#get proc out [PodProcess:pod_proc] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    given proc.out_data as Str:out_data {
        if [update_proc_output[proc]].maybe_raise[stack] {
            return null;
        };
        if proc.out_strip_final_newline && [out_data].ends_with["\n"] {
            return [out_data].slice[0][[out_data].len - 1];
        };
        return [out_data].clone;
    } else {
        return null;
    };
}

#send input [Str:data] to proc [PodProcess:pod_proc] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    given proc.in_data as Str:in_data {
        [in_data].extend[data];
        [await_proc_input_sent[proc]].maybe_raise[stack];
    } else {
        Str:msg = "Cannot send input data to process without piped input";
        [stack].error["cmd"][msg];
    };
}

Bool#poll proc [PodProcess:pod_proc] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    if proc.completed {
        return false;
    };
    return [poll_proc_status[proc]].maybe_raise[stack];
}

#send signal [Str:signame] to [PodProcess:pod_proc] in [PodStack:stack] {
    Process:proc = pod_proc.proc;
    if proc.completed {
        if [signame] equals ["SIGTERM"] {
            return;
        };
        [stack].error["cmd"]["Cannot send signal to completed process"];
        return;
    };
    [send_proc_signal[proc][signame]].maybe_raise[stack];
}
