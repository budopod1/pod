%import platform;
%import iotools;
%import subproc;
%import frames;
%import paths;
%import vals;
%import eval;

@extends PodOpaque;
PodEnvVar {
    $PodVal:var_name,
    $PodVal:var_val
}

@extends PodOpaque;
PodProcess {
    Process:proc
}

Str#[$PodVal:val].cmd_stringify {
    given val as PodArray:array {
        Str:result = [""].clone;
        for $PodVal:elem in array.elems {
            if result {
                [result].append['\0'];
            };
            [result].extend[[elem].get_string];
        };
        return result;
    };
    return [val].get_string;
}

#set output redirection [ProcInitInfo:init] to [Str:str] in [PodStack:stack] stdout: [Bool:stdout] stderr: [Bool:stderr] {
    // todo implement
}

#process cmd symbol arg [Str:str] on [ProcInitInfo:init] in [PodStack:stack] {
    // the target, coming after the '>', can be:
    // 1 (redirect to stdout)
    // 2 (redirect to stderr)
    // . (capture as result)
    // $.* (get the variable's value, repeat this selection)
    // .* (redirect to file)
    if str[0]? == '>' {
        set output redirection [init] to [[str].slice_from[1]]
            in [stack] stdout: [true] stderr: [false];
    } elif str[1]? == '>' {
        Bool:stdout = false;
        Bool:stderr = false;
        switch str[0]
        ('1') {
            stdout = true;
        }
        ('2') {
            stderr = true;
        }
        ('&') {
            stdout = true;
            stderr = true;
        }
        {
            Str:msg = "cannot redirection from '{}'" % str[0];
            temp error msg: [msg];
        };
        set output redirection [init] to [[str].slice_from[2]]
            in [stack] stdout: [stdout] stderr: [stderr];
    } elif str[0]? == '<' {
        abort ["input redirection not implemented"];
    } elif ([str].index_of["*"]) || ([str].index_of["?"])
        || ([str].index_of["["]) || (str[0]? == '~') {
        Str:path_str = [pod expand path [str]].stringify;
        [init.args].extend[glob_paths[[Str] [path_str]]];
    } else {
        [init.args].append[str];
    };
}

PodProcess?#start proc with [[$PodVal]:args] in [PodStack:stack] {
    ProcInitInfo:init = ProcInitInfo [
        0, null, // stdout
        0, null, // stderr
        [ProcEnvVal] [],
        "",
        [Str] []
    ];

    for $PodVal:arg in args {
        given arg as PodNil:nil {
            continue;
        } given arg as PodEnvVar:pod_env_var {
            [init.env_vals].append[ProcEnvVal [
                [pod_env_var.var_name].get_string,
                [pod_env_var.var_val].get_string
            ]];
            continue;
        } given arg as PodSymbol:symbol {
            process cmd symbol arg [symbol.str] on [init] in [stack];
            continue;
        };
        [init.args].append[[arg].cmd_stringify];
    };

    if !init.args {
        temp error msg: ["program name not specified"];
    };
    
    init.program = init.args[0];
    ProcessResult:proc_result = start_proc [init];

    given proc_result.maybe_process as Process:proc {
        return PodProcess ["process", proc];
    } given proc_result.maybe_error as ProcError:error {
        temp error msg: [error.msg];
        return null;
    } else {
        abort;
    };
}

#wait for_ [PodProcess:pod_proc] completion {
    Process:proc = pod_proc.proc;
    if proc.completed {
        return;
    };
    given await_proc_completion[proc] as ProcError:error {
        temp error msg: [error.msg];
    };
}

#poll proc [PodProcess:pod_proc] {
    Process:proc = pod_proc.proc;
    if proc.completed {
        return;
    };
    given poll_proc_status[proc] as ProcError:error {
        temp error msg: [error.msg];
    };
}

#send signal [Str:signame] to [PodProcess:pod_proc] {
    Process:proc = pod_proc.proc;
    if proc.completed {
        if [signame] equals ["SIGTERM"] {
            return;
        };
        temp error msg: ["Cannot send signal to completed process"];
    };
    given send_proc_signal[proc][signame] as ProcError:error {
        temp error msg: [error.msg];
    };
}
