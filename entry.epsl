%import astparser;
%import tokenizer;
%import parsing;
%import iotools;
%import grouper;
%import errors;
%import frames;
%import paths;
%import eval;
%import proc;
%import vals;
%import ast;

PodFnExpr?#parse txt [Str:txt] path: [Path:path] {
    TokenizationResult:tokenization_result = tokenize [txt];
    if tokenization_result.errors {
        report errors [bundle [tokenization_result] txt: [txt] path: [path]];
        return null;
    };

    TokenizationResult:grouping_result =
        group tokens [tokenization_result.tokens];
    if grouping_result.errors {
        report errors [bundle [grouping_result] txt: [txt] path: [path]];
        return null;
    };

    ParseState:parse_state = ParseState [
        grouping_result.tokens, 0, [ParseError] []
    ];

    PodFnExpr?:maybe_fn_expr = parse fn body [parse_state];
    $ErrorBundle:parse_errors = bundle [parse_state.errors]
        txt: [txt] path: [path];
    if report errors [parse_errors] {
        return null;
    };

    return maybe_fn_expr;
}

PodFnExpr#parse file [Path:path] {
    FileReadResult:read_result = read file [path];
    if report errors [read_result.errors] {
        exit with status [1];
    };
    Str:txt = [read_result.txt].unwrap;

    given parse txt [txt] path: [path] as PodFnExpr:fn_expr {
        return fn_expr;
    } else {
        exit with status [1];
        abort;
    };
}

#run file [Path:path] args: [[Str]:args] {
    PodFnExpr:fn_expr = parse file [path];

    PodStack:stack = make new stack;
    PodClearFn:fn = PodClearFn [fn_expr.code, [stack.frames].at[-1]];

    [$PodVal]:file_args = [$PodVal] [];
    for Str:arg in args {
        [file_args].append[PodStr [arg]];
    };

    run clear [fn] with [file_args] in [stack];
}

#run REPL {
    Path:path = Path_from ["<REPL>"];

    PodStack:stack = make new stack;
    PodClearFn:fake_fn = PodClearFn [
        [PodSExpr] [], [stack.frames].at[-1]
    ];
    PodFrame:frame = PodFrame [
        fake_fn,
        true,
        "repl",
        [PodFrameVar] [],
        [$PodVal] []
    ];

    while true {
        print["> "];
        Str:input = read_input_line;

        PodFnExpr?:maybe_fn_expr = parse txt [input] path: [path];
        if !maybe_fn_expr {
            continue;
        };

        $PodVal:result = pod nil;
        for PodSExpr:expr in [maybe_fn_expr].unwrap.code {
            result = evaluate [expr] in [stack];
        };
        println[[result].stringify];
    };
}

Z#main {
    [Str]:argv = get argv;

    given argv[1]? as Str:filename {
        Path:entry_path = Path_from [filename];

        run file [entry_path] args: [[argv].slice_from[1]];
    } else {
        run REPL;
    };

    return 0;
}
