%import linkreadline;

%import commandconfig;
%import astparser;
%import tokenizer;
%import inputline;
%import platform;
%import parsing;
%import iotools;
%import grouper;
%import errors;
%import frames;
%import paths;
%import eval;
%import proc;
%import vals;
%import ast;

PodFnExpr?#parse txt [Str:txt] path: [Path:path] {
    TokenizationResult:tokenization_result = tokenize [txt];
    if tokenization_result.errors {
        report errors [bundle [tokenization_result] txt: [txt] path: [path]];
        return null;
    };

    TokenizationResult:grouping_result =
        group tokens [tokenization_result.tokens];
    if grouping_result.errors {
        report errors [bundle [grouping_result] txt: [txt] path: [path]];
        return null;
    };

    ParseState:parse_state = ParseState [
        grouping_result.tokens, 0, [ParseError] []
    ];

    PodFnExpr?:maybe_fn_expr = parse fn body [parse_state];
    $ErrorBundle:parse_errors = bundle [parse_state.errors]
        txt: [txt] path: [path];
    if report errors [parse_errors] {
        return null;
    };

    return maybe_fn_expr;
}

PodFnExpr?#parse file [Path:path] {
    FileReadResult:read_result = read file [path];
    if report errors [read_result.errors] {
        return null;
    };
    Str:txt = [read_result.txt].unwrap;

    given parse txt [txt] path: [path] as PodFnExpr:fn_expr {
        return fn_expr;
    } else {
        return null;
    };
}

$PodVal?#check run frame [$PodFrame:frame] in [PodStack:stack] {
    FrameRunResult:result = run frame [frame] in [stack];
    given result.ret_val as $PodVal:ret_val {
        return ret_val;
    } given result.error as PodError:error {
        display error [error];
    };
    return null;
}

$PodVal?#run program [PodFnExpr:fn_expr] from [Path:path] args: [[Str]:str_args] {
    PodStack:stack = make new stack;
    PodClearFn:fn = PodClearFn [fn_expr, top lexical frame in [stack]];

    [$PodVal]:file_args = [$PodVal] [];
    for Str:arg in str_args {
        [file_args].append[PodStr [arg]];
    };

    ClearFnPodFrame:frame = make clear frame [fn] args: [file_args];
    frame.important = true;
    frame.label = "prgm";
    given [path].realpath as Path:full_path {
        [frame.vars].append[PodFrameVar [
            "FILE", PodStr [[full_path].stringify]
        ]];
    };
    return check run frame [frame] in [stack];
}

$PodVal?#run file [Path:path] args: [[Str]:str_args] {
    given parse file [path] as PodFnExpr:fn_expr {
        return run program [fn_expr] from [path] args: [str_args];
    } else {
        exit with status [1];
        abort;
    };
}

$PodVal?#run string [Str:txt] args: [[Str]:str_args] {
    Path:path = Path_from["<string>"];
    given parse txt [txt] path: [path] as PodFnExpr:fn_expr {
        return run program [fn_expr] from [path] args: [str_args];
    } else {
        exit with status [1];
        abort;
    };
}

#run podrc in [PodStack:stack] vars: [[PodFrameVar]:vars] {
    Path?:maybe_pod_rc = null;
    given home_Path as Path:home {
        Path:pod_rc = [home] / [".podrc"];
        if [pod_rc].exists {
            maybe_pod_rc = pod_rc;
        };
    };
    if !maybe_pod_rc {
        return;
    };

    PodFnExpr?:maybe_fn_expr = parse file [[maybe_pod_rc].unwrap];
    if !maybe_fn_expr {
        return;
    };

    PodClearFn:fn = PodClearFn [
        [maybe_fn_expr].unwrap,
        top lexical frame in [stack]
    ];
    ClearFnPodFrame:frame = make clear frame [fn]
        args: [[$PodVal] []];
    frame.important = true;
    frame.label = "podrc";
    frame.vars = vars;

    check run frame [frame] in [stack];
}

#run REPL {
    Path:path = Path_from ["<REPL>"];

    PodStack:stack = make new stack;

    PodFrameVar:PROMPT_var = PodFrameVar [
        "PROMPT", PodStr ["> "]
    ];
    [PodFrameVar]:vars = [PodFrameVar] [PROMPT_var];

    run podrc in [stack] vars: [vars];

    set_sigint_captured[true];

    while true {
        Str:prompt_str = "> ";
        $PodVal:prompt_val = PROMPT_var.val;
        given prompt_val as PodStr:str {
            prompt_str = str.val;
        } given prompt_val as $PodFn:fn {
            $PodFrame:frame = make frame in [stack]
                of [fn] args: [[$PodVal] []];
            given check run frame [frame] in [stack] as $PodVal:result {
                prompt_str = [result].get_string;
            };
        } else {
            println["Invalid prompt type {}" % [prompt_val].stringify_type];
        };

        Str:input = inputline[prompt_str];

        PodFnExpr?:maybe_fn_expr = parse txt [input] path: [path];
        if !maybe_fn_expr {
            continue;
        };

        PodClearFn:fn = PodClearFn [
            [maybe_fn_expr].unwrap,
            top lexical frame in [stack]
        ];
        ClearFnPodFrame:frame = make clear frame [fn]
            args: [[$PodVal] []];
        frame.important = true;
        frame.label = "repl";
        frame.vars = vars;

        given check run frame [frame] in [stack] as $PodVal:ret_val {
            if ret_val != pod nil {
                println[[ret_val].get_string];
            };
        };
    };
}

Z#main {
    ConfigProps:config = ConfigProps [[$ConfigProp] [
        StringProp ["exec-str"],
        StringProp ["print-exec-str"],
        StringProp ["filename"],
        StringsProp ["args"],
    ]];

    ArgumentBranch:branch = make root branch;
    [branch].flag[[Str] ["help", "h"]] [CmdShowHelp []]
        help: ["Show this help"];
    [branch].positional[StringInputSource ["filename"]]
        optional: [true] help: ["The file to run"];
    [branch].flag[[Str] ["c"]][StringInputSource ["exec-str"]]
        help: ["Use program passed in as string"];
    [branch].flag[[Str] ["p"]][StringInputSource ["print-exec-str"]]
        help: ["Use program passed in as string, print the result"];
    [branch].positional[MultiStringInputSource ["args", null]]
        optional: [true] help: ["Arguments for the program"];
    
    CommandSpec:spec = CommandSpec [
        config,
        "pod",
        "The Pod shell",
        null,
        branch,
        default help style
    ];

    CommandParsingResult:result = [spec].parse_command_args;

    ConfigChain:chain = ConfigChain [[ConfigValues] [
        result.values
    ]];

    [Str]:rest_args = [chain].get_strings["args"];

    if [chain].try_get["print-exec-str"] {
        // hack to force filename arg to be treated as normal arg
        if [chain].try_get["filename"] {
            [rest_args].insert[0][[chain].get_string["filename"]];
        };

        given run string [[chain].get_string["print-exec-str"]]
            args: [rest_args]
        as $PodVal:result {
            println[[result].get_string];
        };
    } elif [chain].try_get["exec-str"] {
        // hack to force filename arg to be treated as normal arg
        if [chain].try_get["filename"] {
            [rest_args].insert[0][[chain].get_string["filename"]];
        };

        run string [[chain].get_string["exec-str"]] args: [rest_args];
    } elif [chain].try_get["filename"] {
        Str:filename = [chain].get_string["filename"];

        Path:entry_path = Path_from [filename];

        run file [entry_path] args: [rest_args];
    } else {
        run REPL;
    };

    return 0;
}
