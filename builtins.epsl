%import pattern;
%import frames;
%import eval;
%import vals;

$PodVal#run builtin [PodBuiltinFn:builtin] with [[$PodVal]:args] in [PodStack:stack] {
    switch builtin.name
    ("+") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 0;
            for $PodVal:arg in args {
                x += [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 0;
            for $PodVal:arg in args {
                x += [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("-") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x -= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x -= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    (".") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("/") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        R:x = [args[0]] as float;
        for $PodVal:arg in args from 1 {
            x /= [arg] as float;
        };
        return PodFloat [x];
    }
    ("~/") {
        require between [1] and [null] in [args];
        require [args] all match [IntPattern []];
        Z64:x = [args[0]] as int;
        for $PodVal:arg in args from 1 {
            x = x ~/ [arg] as int;
        };
        return PodInt [x];
    }
    ("%") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x %= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x %= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("<") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    (">") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    ("<=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    (">=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    ("=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if !([first] equals [val]) {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("!=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if [first] equals [val] {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("is") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first != val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("isnt") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first == val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("not") {
        return pod bool [![args[0]].is_truthy];
    }
    ("print") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        println[result];
    }
    ("!") {
        PodFrame:frame = [stack.frames].at[-1];
        frame.important = true;
        if args {
            frame.label = [args[0]].get_string;
        };
    }
    ("forever") {
        require between [1] and [1] in [args];
        while true {
            run [args[0]] with [[$PodVal] []] in [stack];
        };
    }
    ("if") {
        require between [2] and [null] in [args];
        if [args].len > 2 {
            abort [">2 args to if not implemented"];
        };
        $PodVal:result = pod nil;
        if [args[0]].is_truthy {
            result = run [args[1]] with [[$PodVal] [args[0]]] in [stack];
        };
        return result;
    }
    ("while") {
        require between [2] and [2] in [args];
        while true {
            $PodVal:cond = run [args[0]] with [[$PodVal] []] in [stack];
            if ![cond].is_truthy {
                break;
            };

            run [args[1]] with [[$PodVal] [cond]] in [stack];
        };
    }
    ("inputline") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        print[result];
        return PodStr [read_input_line];
    }
    ("str") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].get_string];
    }
    ("symbol") {
        require between [1] and [1] in [args];
        return PodSymbol [[args[0]].get_string];
    }
    ("float") {
        require between [1] and [1] in [args];
        if [args[0]].matches[NumberPattern []] {
            return PodFloat [[args[0]] as float];
        };
        given args[0] as PodStr:str {
            given parse_float[str.val] as R:val {
                return PodFloat [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to float" % [args[0]].stringify_type;
        temp error msg: [msg];
    }
    ("int") {
        require between [1] and [1] in [args];
        if [args[0]].matches[IntPattern []] {
            return PodInt [[args[0]] as int];
        } elif [args[0]].matches[NumberPattern []] {
            return PodInt [[args[0]] as float#Z64];
        };
        given args[0] as PodStr:str {
            given parse_int[str.val] as Z64:val {
                return PodInt [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to int" % [args[0]].stringify_type;
        temp error msg: [msg];
    }
    ("array") {
        return PodArray [args];
    }
    ("cons") {
        require between [2] and [2] in [args];
        return PodPair [args[0], args[1]];
    }
    ("set") {
        require between [3] and [null] in [args];
        if [args].len > 3 {
            abort ["set with >3 args not implemented"];
        };
        require [args[0]] matches [SymbolPattern []];
        require [args[1]] matches [ExactSymbolPattern ["="]];
        set var [[args[0]].get_string]
            in [[stack.frames].at[-1]]
            to [args[2]];
    }
    ("car") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.car;
        } else {
            abort ["car with non pair not implemented"];
        };
    }
    ("cdr") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.cdr;
        } else {
            abort ["cdr with non pair not implemented"];
        };
    }
    {
        abort ["{} is not a builtin" % builtin.name];
    };
    return pod nil;
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        ".",
        "/",
        "~/",
        "%",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",
        "not",
        "print",
        "!",
        "forever",
        "if",
        "while",
        "inputline",
        "str",
        "symbol",
        "float",
        "int",
        "array",
        "cons",
        "set",
        "car",
        "cdr",
    ];
    for Str:name in names {
        [stack.fns].append[PodRegisteredFn [
            name, PodBuiltinFn [name, [$PodVal] []]
        ]];
    };
}
