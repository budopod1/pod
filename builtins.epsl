%import builtins.basic;
%import builtins.datatypes;
%import builtins.io;

%import pattern;
%import frames;
%import eval;
%import vals;

@extends BuiltinData;
WhileBuiltinData {
    Bool:cond_ran
}

@extends BuiltinData;
ComposeBuiltinData {
    [$PodVal]:fns
}

@extends BuiltinData;
IfBuiltinData {
    [$PodVal]:cond_fns,
    [$PodVal]:body_fns,
    $PodVal?:else_,
}

PodStr#base [W:base] convert builtin [[$PodVal]:args] prefix: [Str:prefix] {
    if base > 16 {
        abort ["Expected base 16 or less, not {}" % base];
    };

    require between [1] and [1] in [args];
    require [args[0]] matches [IntPattern []];

    Z64:number = [args[0]] as int;
    Bool:is_negative = number < 0;
    if is_negative {
        number *= -1;
    };

    Str:digits = [""].clone;
    while number {
        W:digit_n = (number % base)#W32;
        [digits].append["0123456789abcdef"[digit_n]];
        number = number ~/ base;
    };

    Str:result = [""].clone;
    if is_negative {
        [result].append['-'];
    };
    [result].extend[prefix];
    for Byte:digit in digits step -1 {
        [result].append[digit];
    };
    return PodStr [result];
}

#set vars [[Str]:var_names] in [$LexicalPodFrame:frame] to [[$PodVal]:vals] {
    Str?:maybe_star_name = null;
    [Str]:pre_star_names = [Str] [];
    [Str]:post_star_names = [Str] [];
    L:required_val_count = 0;

    for Str:name in var_names {
        if [name].len == 0 {
            temp error msg: ["Cannot assign to empty symbol"];
        } elif [name].at[-1] == '*' {
            if maybe_star_name {
                temp error msg: ["Cannot have multiple spread assignees"];
            };
            maybe_star_name = [name].slice[0][[name].len-1];
            continue;
        };
        if [name].at[-1] != '?' {
            required_val_count += 1;
        };
        if maybe_star_name {
            [post_star_names].append[name];
        } else {
            [pre_star_names].append[name];
        };
    };
    
    Z:optional_val_count = [vals].len#Z - (required_val_count#Z);
    if optional_val_count < 0 {
        temp error msg: ["Not enough values for all assignees"];
    };

    L:val_idx = 0;

    for Str:name in pre_star_names {
        if [name].at[-1] == '?' {
            $PodVal:val = pod nil;
            if optional_val_count > 0 {
                val = vals[val_idx];
                val_idx += 1;
                optional_val_count -= 1;
            };
            set var [[name].slice[0][[name].len-1]]
                in [frame]
                to [val];
        } else {
            set var [name]
                in [frame]
                to [vals[val_idx]];
            val_idx += 1;
        };
    };

    for Str:name in post_star_names step -1 {
        if [name].at[-1] == '?' {
            $PodVal:val = pod nil;
            if optional_val_count > 0 {
                val = [vals].pop_end;
                optional_val_count -= 1;
            };
            set var [[name].slice[0][[name].len-1]]
                in [frame]
                to [val];
        } else {
            set var [name]
                in [frame]
                to [[vals].pop_end];
        };
    };

    given maybe_star_name as Str:star_name {
        set var [star_name]
            in [frame]
            to [PodArray [[vals].slice_from[val_idx]]];
    };
}

$PodVal?#builtin cycle of [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    $LexicalPodFrame:lexical_frame = top lexical frame in [stack];
    
    given run basic builtin [frame] as $PodVal?:result {
        return result;
    };

    given run datatype builtin [frame] as $PodVal?:result {
        return result;
    };

    switch builtin.name
    ("not") {
        return pod bool [![args[0]].is_truthy];
    }

    ("any") {
        for $PodVal:val in args {
            if [val].is_truthy {
                return pod bool [true];
            };
        };
        return pod bool [false];
    }

    ("all") {
        for $PodVal:val in args {
            if ![val].is_truthy {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    // TODO: some/every are equivalent to any/all except they take
    // an iterable and (optionally) a mapping function

    ("min") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:min = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x < min {
                    min = x;
                };
            };
            return PodInt [min];
        } else {
            R:min = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x < min {
                    min = x;
                };
            };
            return PodFloat [min];
        };
    }

    ("max") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:max = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x > max {
                    max = x;
                };
            };
            return PodInt [max];
        } else {
            R:max = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x > max {
                    max = x;
                };
            };
            return PodFloat [max];
        };
    }

    ("abs") {
        require between [1] and [1] in [args];
        require [args[0]] matches [NumberPattern []];
        if [args[0]].matches[IntPattern []] {
            Z64:val = [args[0]] as int;
            return PodInt [|[val]|];
        } else {
            R:val = [args[0]] as float;
            return PodFloat [|[val]|];
        };
    }


    ("!") {
        lexical_frame.important = true;
        if args {
            lexical_frame.label = [args[0]].get_string;
        };
        return pod nil;
    }

    ("forever") {
        require between [1] and [1] in [args];
        $PodFrame:sub_frame = make frame in [stack]
            of [args[0]] args: [[$PodVal] []];
        [stack.frames].append[sub_frame];
        return null;
    }

    ("if") {
        given frame.data as IfBuiltinData:data {
            given frame.recieved as $PodVal:recieved {
                $PodVal:body_fn = [data.body_fns].pop[0];
                if [recieved].is_truthy {
                    $PodFrame:sub_frame = make frame in [stack]
                        of [body_fn] args: [[$PodVal] [recieved]];
                    replace top of [stack] with [sub_frame];
                    return null;
                };
            };
            if data.cond_fns {
                $PodFrame:sub_frame = make frame in [stack]
                    of [[data.cond_fns].pop[0]] args: [[$PodVal] []];
                [stack.frames].append[sub_frame];
                return null;
            };
            given data.else_ as $PodVal:else_ {
                $PodFrame:sub_frame = make frame in [stack]
                    of [else_] args: [[$PodVal] []];
                replace top of [stack] with [sub_frame];
                return null;
            } else {
                return pod nil;
            };
        };

        require between [2] and [null] in [args];
        if [args[0]].is_truthy {
            $PodFrame:sub_frame = make frame in [stack]
                of [args[1]] args: [[$PodVal] [args[0]]];
            replace top of [stack] with [sub_frame];
            return null;
        };
        if [args].len == 2 {
            return pod nil;
        };

        W:i = 2;
        IfBuiltinData:new_data = IfBuiltinData [
            [$PodVal] [], [$PodVal] [], null
        ];
        while i < [args].len {
            if new_data.else_ {
                temp error msg: ["Expected nothing in if after 'else'"];
            };
            $PodVal:keyword_val = args[i];
            require [keyword_val] matches [EitherPattern [[$Pattern] [
                ExactSymbolPattern ["elif"],
                ExactSymbolPattern ["else"]
            ]]];

            switch [keyword_val].get_string
            ("elif") {
                if i + 2 >= [args].len {
                    Str:msg = "Expected condition and body after 'elif'";
                    temp error msg: [msg];
                };
                [new_data.cond_fns].append[args[i + 1]];
                [new_data.body_fns].append[args[i + 2]];
                i += 3;
            }
            ("else") {
                if i + 1 >= [args].len {
                    temp error msg: ["Expected body after 'else'"];
                };
                new_data.else_ = args[i + 1];
                i += 2;
            }
            {abort;};
        };

        frame.data = new_data;
        return null;
    }

    ("while") {
        given frame.data as WhileBuiltinData:data {
            if data.cond_ran {
                $PodVal:cond_val = [frame.recieved].unwrap;
                if ![cond_val].is_truthy {
                    return pod nil;
                };
                if [args].len >= 2 {
                    $PodFrame:sub_frame = make frame in [stack]
                        of [args[1]] args: [[$PodVal] [cond_val]];
                    [stack.frames].append[sub_frame];
                    data.cond_ran = false;
                    return null;
                };
            };

            $PodFrame:sub_frame = make frame in [stack]
                of [args[0]] args: [[$PodVal] []];
            [stack.frames].append[sub_frame];
            data.cond_ran = true;
            return null;
        };
        require between [1] and [2] in [args];
        frame.data = WhileBuiltinData [false];
        return null;
    }
    
    ("choose") {
        require between [3] and [3] in [args];
        if [args[0]].is_truthy {
            return args[1];
        } else {
            return args[2];
        };
    }
    
    ("return") {
        require between [0] and [2] in [args];
        $PodVal:ret_val = [args[0]?] || [pod nil];
        Str?:maybe_label = null;
        given args[1]? as $PodVal:label_arg {
            require [label_arg] matches [TxtPattern []];
            maybe_label = [label_arg].get_string;
        };
        while true {
            given maybe_label as Str:label {
                if [lexical_frame.label] equals [label#Str?] {
                    break;
                };
            } else {
                if lexical_frame.important {
                    break;
                };
            };
            given lexical_frame as RootPodFrame:root_frame {
                temp error msg: ["Cannot return from root frame"];
            } given lexical_frame.parent as $LexicalPodFrame:new_frame {
                lexical_frame = new_frame;
            } else {
                temp error msg: ["No such frame to return from"];
            };
        };
        while [stack.frames].at[-1] != lexical_frame {
            [stack.frames].pop_end;
        };
        pop frame in [stack] returning [ret_val];
        return null;
    }

    ("declare") {
        require [args] all match [SymbolPattern []];
        for $PodVal:arg in args {
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            set local var [name] in [lexical_frame] to [pod nil];
        };
        return pod nil;
    }

    ("assign") {
        require between [2] and [2] in [args];
        require [args[0]] matches [SymbolPattern []];
        Str:name = [args[0]#PodSymbol?].unwrap.str;
        $PodVal:val = args[1]; 
        set var [name] in [lexical_frame] to [val];
        return val;
    }

    ("set") {
        require between [3] and [null] in [args];

        if [args].len == 3 {
            require [args[0]] matches [SymbolPattern []];
            require [args[1]] matches [ExactSymbolPattern ["="]];
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            if [name].at[-1] != '*' {
                set var [name]
                    in [lexical_frame]
                    to [args[2]];
                return pod nil;
            };
        };

        Bool:found_eq = false;
        [Str]:var_names = [Str] [];
        [$PodVal]:vals = [$PodVal] [];
        for $PodVal:arg in args {
            if found_eq {
                [vals].append[arg];
            } else {
                require [arg] matches [SymbolPattern []];
                Str:name = [arg#PodSymbol?].unwrap.str;
                if [name] equals ["="] {
                    found_eq = true;
                } else {
                    [var_names].append[name];
                };
            };
        };

        set vars [var_names] in [lexical_frame] to [vals];

        return pod nil;
    }

    ("args") {
        require between [1] and [null] in [args];
        require [[args].at[-1]] matches [FnPattern []];
        return PodBuiltinFn ["#args", args];
    }

    ("#args") {
        $PodFrame:sub_frame = make frame in [stack]
            of [[builtin.data].at[-1]] args: [args];
        replace top of [stack] with [sub_frame];
        given sub_frame as $LexicalPodFrame:lexical_frame {
            [Str]:var_names = [Str] [];
            for $PodVal:name_val in builtin.data to [builtin.data].len-1 {
                require [name_val] matches [SymbolPattern []];
                [var_names].append[[name_val#PodSymbol?].unwrap.str];
            };
            set vars [var_names] in [lexical_frame] to [args];
        } else {
            Str:msg = "Cannot set argument variables in non lexical frame";
            temp error msg: [msg];
        };
        return null;
    }

    ("car") {
        require between [1] and [1] in [args];
        $PodVal:val = args[0];
        given args[0] as PodPair:pair {
            return pair.car;
        } given val as PodNil:nil {
            return nil;
        } else {
            abort ["car with {} not implemented" % [val].stringify_type];
        };
    }

    ("cdr") {
        require between [1] and [1] in [args];
        $PodVal:val = args[0];
        given val as PodPair:pair {
            return pair.cdr;
        } given val as PodNil:nil {
            return nil;
        } else {
            abort ["cdr with {} not implemented" % [val].stringify_type];
        };
    }

    ("both") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return PodArray [[$PodVal] [pair.car, pair.cdr]];
        } else {
            abort ["both with non pair not implemented"];
        };
    }

    ("defun") {
        require between [2] and [2] in [args];
        require [args[0]] matches [SymbolPattern []];
        require [args[1]] matches [FnPattern []];
        register fn [[args[1]#$PodFn?].unwrap]
            under [[args[0]].get_string]
            in [stack];
        return pod nil;
    }

    ("getfun") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:fn_name = [args[0]].get_string;
        given lookup registered fn [fn_name] in [stack] as $PodFn:fn {
            return fn;
        } else {
            return pod nil;
        };
    }

    ("repr") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].stringify];
    }

    ("bin") {
        return base [2] convert builtin [args] prefix: ["0b"];
    }

    ("oct") {
        return base [8] convert builtin [args] prefix: ["0o"];
    }

    ("hex") {
        return base [16] convert builtin [args] prefix: ["0x"];
    }

    ("par") { // partial application
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#par", args];
    }

    ("#par") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [[builtin.data].slice_from[1]] + [args];
        $PodFrame:sub_frame = make frame in [stack] of [fn] args: [full_args];
        replace top of [stack] with [sub_frame];
        return null;
    }

    ("rpar") { // reverse partial application
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#rpar", args];
    }

    ("#rpar") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [args] + [[builtin.data].slice_from[1]];
        $PodFrame:sub_frame = make frame in [stack] of [fn] args: [full_args];
        replace top of [stack] with [sub_frame];
        return null;
    }

    ("compose") {
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#compose", args];
    }

    ("#compose") {
        given frame.data as ComposeBuiltinData:data {
            $PodVal:val = [frame.recieved].unwrap;
            if !data.fns {
                return val;
            };
            $PodFrame:sub_frame = make frame in [stack]
                of [[data.fns].pop_end] args: [[$PodVal] [val]];
            [stack.frames].append[sub_frame];
        } else {
            frame.data = ComposeBuiltinData [builtin.data];
            $PodFrame:sub_frame = make frame in [stack]
                of [[builtin.data].pop_end] args: [args];
            [stack.frames].append[sub_frame];
        };
        return null;
    }

    ("_") { // the identity function
        require between [1] and [1] in [args];
        return args[0];
    }

    ("C") { // creates a constant function
        require between [1] and [1] in [args];
        return PodBuiltinFn ["#C", args];
    }

    ("#C") {
        return builtin.data[0];
    }

    ("ord") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:str = [args[0]].get_string;
        given str[0]? as Byte:first_byte {
            return PodInt [first_byte];
        } else {
            return pod nil;
        };
    }

    ("chr") {
        require [args] all match [IntPattern []];
        Str:result = [""].clone;
        for $PodVal:val in args {
            Z64:int = [val] as int;
            if (int < 0 || int > 255) {
                temp error msg: ["Invalid byte value {}" % int];
            };
            [result].append[int#Byte];
        };
        return PodStr [result];
    };

    given run io builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    abort ["{} is not a builtin" % builtin.name];
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        ".",
        "/",
        "~/",
        "%",
        "^",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",

        "str",
        "symbol",
        "float",
        "int",
        "bool",
        "arr",
        "cons",
        "list",
        "error",
        "typestr",
        "nilp",
        "nil~p",

        "not",
        "any",
        "all",
        "min",
        "max",
        "abs",
        "!",
        "forever",
        "if",
        "while",
        "choose",
        "return",

        "declare",
        "assign",
        "set",
        "args",
        "#args",
        "car",
        "cdr",
        "both",
        "defun",
        "getfun",
        "repr",
        "bin",
        "oct",
        "hex",
        "par",
        "#par",
        "rpar",
        "#rpar",
        "compose",
        "#compose",
        "_",
        "C",
        "#C",
        "chr",
        "ord",

        "print",
        "inputline",
        "getenv",
        "setenv",
        "unsetenv",
        "time",
        "unixtime",
        "perfcounter",
        "exit",
        "cwd",
        "cd",
        "cmd",
    ];
    for Str:name in names {
        $PodFn:fn = PodBuiltinFn [name, [$PodVal] []];
        register fn [fn] under [name] in [stack];
    };
}
