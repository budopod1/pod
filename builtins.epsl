%import pattern;
%import frames;
%import eval;
%import vals;

@extends BuiltinData;
WhileBuiltinData {
    Bool:cond_ran
}

@extends BuiltinData;
ComposeBuiltinData {
    [$PodVal]:fns
}

@extends BuiltinData;
IfBuiltinData {
    [$PodVal]:cond_fns,
    [$PodVal]:body_fns,
    $PodVal?:else_,
}

PodStr#base [W:base] convert builtin [[$PodVal]:args] prefix: [Str:prefix] {
    if base > 16 {
        abort ["Expected base 16 or less, not {}" % base];
    };

    require between [1] and [1] in [args];
    require [args[0]] matches [IntPattern []];

    Z64:number = [args[0]] as int;
    Bool:is_negative = number < 0;
    if is_negative {
        number *= -1;
    };

    Str:digits = [""].clone;
    while number {
        W:digit_n = (number % base)#W32;
        [digits].append["0123456789abcdef"[digit_n]];
        number = number ~/ base;
    };

    Str:result = [""].clone;
    if is_negative {
        [result].append['-'];
    };
    [result].extend[prefix];
    for Byte:digit in digits step -1 {
        [result].append[digit];
    };
    return PodStr [result];
}

$PodVal?#builtin cycle of [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    $PodFrame:parent_frame = [stack.frames].at[-2];
    switch builtin.name
    ("+") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 0;
            for $PodVal:arg in args {
                x += [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 0;
            for $PodVal:arg in args {
                x += [arg] as float;
            };
            return PodFloat [x];
        };
    }

    ("-") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x -= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x -= [arg] as float;
            };
            return PodFloat [x];
        };
    }

    (".") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as float;
            };
            return PodFloat [x];
        };
    }

    ("/") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        R:x = [args[0]] as float;
        for $PodVal:arg in args from 1 {
            x /= [arg] as float;
        };
        return PodFloat [x];
    }

    ("~/") {
        require between [1] and [null] in [args];
        require [args] all match [IntPattern []];
        Z64:x = [args[0]] as int;
        for $PodVal:arg in args from 1 {
            x = x ~/ [arg] as int;
        };
        return PodInt [x];
    }

    ("%") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x %= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x %= [arg] as float;
            };
            return PodFloat [x];
        };
    }

    ("<") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }

    (">") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }

    ("<=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }

    (">=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }

    ("=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if !([first] equals [val]) {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }

    ("!=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if [first] equals [val] {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }

    ("is") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first != val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }

    ("isnt") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first == val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }

    ("not") {
        return pod bool [![args[0]].is_truthy];
    }

    ("any") {
        for $PodVal:val in args {
            if [val].is_truthy {
                return pod bool [true];
            };
        };
        return pod bool [false];
    }

    ("all") {
        for $PodVal:val in args {
            if ![val].is_truthy {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    // TODO: some/every are equivalent to any/all except they take
    // an iterable and (optionally) a mapping function

    ("min") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:min = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x < min {
                    min = x;
                };
            };
            return PodInt [min];
        } else {
            R:min = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x < min {
                    min = x;
                };
            };
            return PodFloat [min];
        };
    }

    ("max") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:max = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x > max {
                    max = x;
                };
            };
            return PodInt [max];
        } else {
            R:max = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x > max {
                    max = x;
                };
            };
            return PodFloat [max];
        };
    }

    ("abs") {
        require between [1] and [1] in [args];
        require [args[0]] matches [NumberPattern []];
        if [args[0]].matches[IntPattern []] {
            Z64:val = [args[0]] as int;
            return PodInt [|[val]|];
        } else {
            R:val = [args[0]] as float;
            return PodFloat [|[val]|];
        };
    }

    ("print") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        println[result];
        return pod nil;
    }

    ("!") {
        parent_frame.important = true;
        if args {
            parent_frame.label = [args[0]].get_string;
        };
        return pod nil;
    }

    ("forever") {
        require between [1] and [1] in [args];
        $PodFrame:sub_frame = make frame in [stack]
            of [args[0]] args: [[$PodVal] []];
        [stack.frames].append[sub_frame];
        return null;
    }

    ("if") {
        given frame.data as IfBuiltinData:data {
            given frame.recieved as $PodVal:recieved {
                $PodVal:body_fn = [data.body_fns].pop[0];
                if [recieved].is_truthy {
                    $PodFrame:sub_frame = make frame in [stack]
                        of [body_fn] args: [[$PodVal] [recieved]];
                    replace top of [stack] with [sub_frame];
                    return null;
                };
            };
            if data.cond_fns {
                $PodFrame:sub_frame = make frame in [stack]
                    of [[data.cond_fns].pop[0]] args: [[$PodVal] []];
                [stack.frames].append[sub_frame];
                return null;
            };
            given data.else_ as $PodVal:else_ {
                $PodFrame:sub_frame = make frame in [stack]
                    of [else_] args: [[$PodVal] []];
                replace top of [stack] with [sub_frame];
                return null;
            } else {
                return pod nil;
            };
        };

        require between [2] and [null] in [args];
        if [args[0]].is_truthy {
            $PodFrame:sub_frame = make frame in [stack]
                of [args[1]] args: [[$PodVal] [args[0]]];
            replace top of [stack] with [sub_frame];
            return null;
        };
        if [args].len == 2 {
            return pod nil;
        };

        W:i = 2;
        IfBuiltinData:new_data = IfBuiltinData [
            [$PodVal] [], [$PodVal] [], null
        ];
        while i < [args].len {
            if new_data.else_ {
                temp error msg: ["Expected nothing in if after 'else'"];
            };
            $PodVal:keyword_val = args[i];
            require [keyword_val] matches [EitherPattern [[$Pattern] [
                ExactSymbolPattern ["elif"],
                ExactSymbolPattern ["else"]
            ]]];

            switch [keyword_val].get_string
            ("elif") {
                if i + 2 >= [args].len {
                    Str:msg = "Expected condition and body after 'elif'";
                    temp error msg: [msg];
                };
                [new_data.cond_fns].append[args[i + 1]];
                [new_data.body_fns].append[args[i + 2]];
                i += 3;
            }
            ("else") {
                if i + 1 >= [args].len {
                    temp error msg: ["Expected body after 'else'"];
                };
                new_data.else_ = args[i + 1];
                i += 2;
            }
            {abort;};
        };

        frame.data = new_data;
        return null;
    }

    ("while") {
        given frame.data as WhileBuiltinData:data {
            if data.cond_ran {
                $PodVal:cond_val = [frame.recieved].unwrap;
                if ![cond_val].is_truthy {
                    return pod nil;
                };
                if [args].len >= 2 {
                    $PodFrame:sub_frame = make frame in [stack]
                        of [args[1]] args: [[$PodVal] [cond_val]];
                    [stack.frames].append[sub_frame];
                    data.cond_ran = false;
                    return null;
                };
            };

            $PodFrame:sub_frame = make frame in [stack]
                of [args[0]] args: [[$PodVal] []];
            [stack.frames].append[sub_frame];
            data.cond_ran = true;
            return null;
        };
        require between [1] and [2] in [args];
        frame.data = WhileBuiltinData [false];
        return null;
    }
    
    ("return") {
        require between [0] and [2] in [args];
        $PodVal:ret_val = [args[0]?] || [pod nil];
        Z:pop_count = 1;
        given args[1]? as $PodVal:label_arg {
            require [label_arg] matches [TxtPattern []];
            Str:label = [label_arg].get_string;
            while true {
                $PodFrame:frame = [stack.frames].at[-pop_count];
                if frame#RootPodFrame? {
                    temp error msg: ["Label '{}' cannot be returned from" % label];
                };
                if [frame.label] equals [label#Str?] {
                    break;
                };
                pop_count += 1;
            };
        } else {
            while true {
                $PodFrame:frame = [stack.frames].at[-pop_count];
                if frame#RootPodFrame? {
                    temp error msg: ["Cannot return from root frame"];
                };
                if frame.important {
                    break;
                };
                pop_count += 1;
            };
        };
        for Z:i to pop_count - 1 {
            [stack.frames].pop_end;
        };
        pop frame in [stack] returning [ret_val];
        return null;
    }

    ("inputline") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        print[result];
        return PodStr [read_input_line];
    }

    ("str") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].get_string];
    }

    ("symbol") {
        require between [1] and [1] in [args];
        return PodSymbol [[args[0]].get_string];
    }

    ("float") {
        require between [1] and [1] in [args];
        if [args[0]].matches[NumberPattern []] {
            return PodFloat [[args[0]] as float];
        };
        given args[0] as PodStr:str {
            given parse_float[str.val] as R:val {
                return PodFloat [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to float" % [args[0]].stringify_type;
        temp error msg: [msg];
        abort;
    }

    ("int") {
        require between [1] and [1] in [args];
        if [args[0]].matches[IntPattern []] {
            return PodInt [[args[0]] as int];
        } elif [args[0]].matches[NumberPattern []] {
            return PodInt [[args[0]] as float#Z64];
        };
        given args[0] as PodStr:str {
            given parse_int[str.val] as Z64:val {
                return PodInt [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to int" % [args[0]].stringify_type;
        temp error msg: [msg];
        abort;
    }

    ("bool") {
        require between [1] and [1] in [args];
        return pod bool [[args[0]].is_truthy];
    }

    ("arr") {
        return PodArray [args];
    }

    ("cons") {
        require between [2] and [2] in [args];
        return PodPair [args[0], args[1]];
    }

    ("list") {
        $PodVal:result = pod nil;
        for $PodVal:val in args step -1 {
            result = PodPair [val, result];
        };
        return result;
    }

    ("declare") {
        require [args] all match [SymbolPattern []];
        for $PodVal:arg in args {
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            set var [name] in [parent_frame] to [pod nil];
        };
        return pod nil;
    }

    ("assign") {
        require between [2] and [2] in [args];
        require [args[0]] matches [SymbolPattern []];
        Str:name = [args[0]#PodSymbol?].unwrap.str;
        $PodVal:val = args[1]; 
        set var [name] in [parent_frame] to [val];
        return val;
    }

    ("set") {
        require between [3] and [null] in [args];

        if [args].len == 3 {
            require [args[0]] matches [SymbolPattern []];
            require [args[1]] matches [ExactSymbolPattern ["="]];
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            if [name].at[-1] != '*' {
                set var [name]
                    in [parent_frame]
                    to [args[2]];
                return pod nil;
            };
        };

        Str?:maybe_star_name = null;
        [Str]:pre_star_names = [Str] [];
        [Str]:post_star_names = [Str] [];
        L:required_val_count = 0;
        L:val_start_idx = 0;

        for $PodVal:arg in args {
            val_start_idx += 1;
            require [arg] matches [SymbolPattern []];
            Str:name = [arg#PodSymbol?].unwrap.str;
            if [name] equals ["="] {
                break;
            } elif [name].len == 0 {
                temp error msg: ["Cannot assign to empty symbol"];
            } elif [name].at[-1] == '*' {
                if maybe_star_name {
                    temp error msg: ["Cannot have multiple spread assignees"];
                };
                maybe_star_name = [name].slice[0][[name].len-1];
                continue;
            };
            if [name].at[-1] != '?' {
                required_val_count += 1;
            };
            if maybe_star_name {
                [post_star_names].append[name];
            } else {
                [pre_star_names].append[name];
            };
        };

        [$PodVal]:vals = [args].slice_from[val_start_idx];

        Z:optional_val_count = [vals].len#Z - (required_val_count#Z);
        if optional_val_count < 0 {
            temp error msg: ["Not enough values for all assignees"];
        };

        L:val_idx = 0;

        for Str:name in pre_star_names {
            if [name].at[-1] == '?' {
                $PodVal:val = pod nil;
                if optional_val_count > 0 {
                    val = vals[val_idx];
                    val_idx += 1;
                    optional_val_count -= 1;
                };
                set var [[name].slice[0][[name].len-1]]
                    in [parent_frame]
                    to [val];
            } else {
                set var [name]
                    in [parent_frame]
                    to [vals[val_idx]];
                val_idx += 1;
            };
        };

        for Str:name in post_star_names step -1 {
            if [name].at[-1] == '?' {
                $PodVal:val = pod nil;
                if optional_val_count > 0 {
                    val = [vals].pop_end;
                    optional_val_count -= 1;
                };
                set var [[name].slice[0][[name].len-1]]
                    in [parent_frame]
                    to [val];
            } else {
                set var [name]
                    in [parent_frame]
                    to [[vals].pop_end];
            };
        };

        given maybe_star_name as Str:star_name {
            set var [star_name]
                in [frame]
                to [PodArray [[vals].slice_from[val_idx]]];
        };

        return pod nil;
    }

    ("car") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.car;
        } else {
            abort ["car with non pair not implemented"];
        };
    }

    ("cdr") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.cdr;
        } else {
            abort ["cdr with non pair not implemented"];
        };
    }

    ("defun") {
        require between [2] and [2] in [args];
        require [args[0]] matches [SymbolPattern []];
        require [args[1]] matches [FnPattern []];
        register fn [[args[1]#$PodFn?].unwrap]
            under [[args[0]].get_string]
            in [stack];
        return pod nil;
    }

    ("getfun") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:fn_name = [args[0]].get_string;
        given lookup registered fn [fn_name] in [stack] as $PodFn:fn {
            return fn;
        } else {
            return pod nil;
        };
    }

    ("repr") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].stringify];
    }

    ("bin") {
        return base [2] convert builtin [args] prefix: ["0b"];
    }

    ("oct") {
        return base [8] convert builtin [args] prefix: ["0o"];
    }

    ("hex") {
        return base [16] convert builtin [args] prefix: ["0x"];
    }

    ("par") { // partial application
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#par", args];
    }

    ("#par") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [[builtin.data].slice_from[1]] + [args];
        $PodFrame:sub_frame = make frame in [stack] of [fn] args: [full_args];
        replace top of [stack] with [sub_frame];
        return null;
    }

    ("compose") {
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#compose", args];
    }

    ("#compose") {
        given frame.data as ComposeBuiltinData:data {
            $PodVal:val = [frame.recieved].unwrap;
            if !data.fns {
                return val;
            };
            $PodFrame:sub_frame = make frame in [stack]
                of [[data.fns].pop_end] args: [[$PodVal] [val]];
            [stack.frames].append[sub_frame];
        } else {
            frame.data = ComposeBuiltinData [builtin.data];
            $PodFrame:sub_frame = make frame in [stack]
                of [[builtin.data].pop_end] args: [args];
            [stack.frames].append[sub_frame];
        };
        return null;
    }

    ("I") { // the identity function
        require between [1] and [1] in [args];
        return args[0];
    }

    ("C") { // creates a constant function
        require between [1] and [1] in [args];
        return PodBuiltinFn ["#C", args];
    }

    ("#C") {
        return builtin.data[0];
    }

    ("ord") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:str = [args[0]].get_string;
        given str[0]? as Byte:first_byte {
            return PodInt [first_byte];
        } else {
            return pod nil;
        };
    }

    ("chr") {
        require [args] all match [IntPattern []];
        Str:result = [""].clone;
        for $PodVal:val in args {
            Z64:int = [val] as int;
            if (int < 0 || int > 255) {
                temp error msg: ["Invalid byte value {}" % int];
            };
            [result].append[int#Byte];
        };
        return PodStr [result];
    }

    {
        abort ["{} is not a builtin" % builtin.name];
    };
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        ".",
        "/",
        "~/",
        "%",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",
        "not",
        "any",
        "all",
        "min",
        "max",
        "abs",
        "print",
        "!",
        "forever",
        "if",
        "while",
        "return",
        "inputline",
        "str",
        "symbol",
        "float",
        "int",
        "bool",
        "arr",
        "cons",
        "list",
        "declare",
        "assign",
        "set",
        "car",
        "cdr",
        "defun",
        "getfun",
        "repr",
        "bin",
        "oct",
        "hex",
        "par",
        "#par",
        "compose",
        "#compose",
        "I",
        "C",
        "#C",
        "chr",
        "ord",
    ];
    for Str:name in names {
        $PodFn:fn = PodBuiltinFn [name, [$PodVal] []];
        register fn [fn] under [name] in [stack];
    };
}
