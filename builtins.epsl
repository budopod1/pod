%import builtins.basic;
%import builtins.datatypes;
%import builtins.flow;
%import builtins.iter;
%import builtins.cmd;
%import builtins.io;

%import pattern;
%import frames;
%import eval;
%import vals;

@extends BuiltinData;
ComposeBuiltinData {
    [$PodVal]:fns
}

@extends BuiltinData;
InplaceSetBuiltinData {
    Str:name,
    $PodVal:og_val
}

PodStr?#base [W:base] convert builtin [[$PodVal]:args] in [PodStack:stack] prefix: [Str:prefix] {
    if base > 16 {
        abort ["Expected base 16 or less, not {}" % base];
    };

    require in [stack] between [1] and [1] in [args];
    require in [stack] [args[0]?] matches [IntPattern []];
    if stack.active_error {return null;};

    Z64:number = [args[0]] as int;
    Bool:is_negative = number < 0;
    if is_negative {
        number *= -1;
    };

    Str:digits = [""].clone;
    while number {
        W:digit_n = (number % base)#W32;
        [digits].append["0123456789abcdef"[digit_n]];
        number = number ~/ base;
    };

    Str:result = [""].clone;
    if is_negative {
        [result].append['-'];
    };
    [result].extend[prefix];
    for Byte:digit in digits step -1 {
        [result].append[digit];
    };
    return PodStr [result];
}

#set vars [[Str]:var_names] of [$LexicalPodFrame:frame] in [PodStack:stack] to [[$PodVal]:vals] {
    Str?:maybe_spread_name = null;
    [Str]:pre_spread_names = [Str] [];
    [Str]:post_spread_names = [Str] [];
    L:required_val_count = 0;

    for Str:name in var_names {
        if [name].len == 0 {
            [stack].error["arg"]["Cannot assign to empty symbol"];
            return;
        } elif [name].at[-1] == ':' {
            if maybe_spread_name {
                [stack].error["arg"]["Cannot have multiple spread assignees"];
                return;
            };
            maybe_spread_name = [name].slice[0][[name].len-1];
            continue;
        };
        if [name].at[-1] != '?' {
            required_val_count += 1;
        };
        if maybe_spread_name {
            [post_spread_names].append[name];
        } else {
            [pre_spread_names].append[name];
        };
    };
    
    Z:optional_val_count = [vals].len#Z - (required_val_count#Z);
    if optional_val_count < 0 {
        [stack].error["arg"]["Not enough values for all assignees"];
        return;
    };

    L:val_idx = 0;

    for Str:name in pre_spread_names {
        if [name].at[-1] == '?' {
            $PodVal:val = pod nil;
            if optional_val_count > 0 {
                val = vals[val_idx];
                val_idx += 1;
                optional_val_count -= 1;
            };
            set var [[name].slice[0][[name].len-1]]
                in [frame]
                to [val];
        } else {
            set var [name]
                in [frame]
                to [vals[val_idx]];
            val_idx += 1;
        };
    };

    for Str:name in post_spread_names step -1 {
        if [name].at[-1] == '?' {
            $PodVal:val = pod nil;
            if optional_val_count > 0 {
                val = [vals].pop_end;
                optional_val_count -= 1;
            };
            set var [[name].slice[0][[name].len-1]]
                in [frame]
                to [val];
        } else {
            set var [name]
                in [frame]
                to [[vals].pop_end];
        };
    };

    given maybe_spread_name as Str:spread_name {
        set var [spread_name]
            in [frame]
            to [PodArray [[vals].slice_from[val_idx]]];
    };
}

Str#lstrip [Str:str] of [Str:chars] {
    for L:i enumerating str {
        if ![chars].index_of[str[i]] {
            return [str].slice_from[i];
        };
    };
    return "";
}

Str#rstrip [Str:str] of [Str:chars] {
    for L:i enumerating str step -1 {
        if ![chars].index_of[str[i]] {
            return [str].slice[0][i+1];
        };
    };
    return "";
}

$PodVal?#builtin cycle of [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    $LexicalPodFrame:lexical_frame = top lexical frame in [stack];
    
    given run basic builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run datatype builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run flow builtin [frame] in [stack] lexical: [lexical_frame]
    as $PodVal?:result {
        return result;
    };

    given run iter builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    switch builtin.name
    ("not") {
        return pod bool [![args[0]].is_truthy];
    }

    ("or") {
        $PodVal:last = pod bool [false];
        given frame.recieved as $PodVal:recieved {
            if [recieved].is_truthy {
                return recieved;
            };
            last = recieved;
        };
        if args {
            given make frame in [stack]
                of [[args].pop[0]] args: [[$PodVal] []]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            return null;
        } else {
            return last;
        };
    }

    ("and") {
        $PodVal:last = pod bool [true];
        given frame.recieved as $PodVal:recieved {
            if ![recieved].is_truthy {
                return recieved;
            };
            last = recieved;
        };
        if args {
            given make frame in [stack]
                of [[args].pop[0]] args: [[$PodVal] []]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
            return null;
        } else {
            return last;
        };
    }

    ("any") {
        $PodVal:last = pod bool [false];
        for $PodVal:val in args {
            if [val].is_truthy {
                return val;
            };
            last = val;
        };
        return last;
    }

    ("all") {
        $PodVal:last = pod bool [true];
        for $PodVal:val in args {
            if ![val].is_truthy {
                return val;
            };
            last = val;
        };
        return last;
    }
    // TODO: some/every are equivalent to any/all except they take
    // an iterable and (optionally) a mapping function

    ("min") {
        require in [stack] between [1] and [null] in [args];
        require in [stack] [args] all match [NumberPattern []];
        if stack.active_error {return null#$PodVal?;};
        if [args].all_match[IntPattern []] {
            Z64:min = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x < min {
                    min = x;
                };
            };
            return PodInt [min];
        } else {
            R:min = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x < min {
                    min = x;
                };
            };
            return PodFloat [min];
        };
    }

    ("max") {
        require in [stack] between [1] and [null] in [args];
        require in [stack] [args] all match [NumberPattern []];
        if stack.active_error {return null#$PodVal?;};
        if [args].all_match[IntPattern []] {
            Z64:max = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:x = [arg] as int;
                if x > max {
                    max = x;
                };
            };
            return PodInt [max];
        } else {
            R:max = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:x = [arg] as float;
                if x > max {
                    max = x;
                };
            };
            return PodFloat [max];
        };
    }

    ("abs") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [NumberPattern []];
        if stack.active_error {return null#$PodVal?;};
        if [args[0]].matches[IntPattern []] {
            Z64:val = [args[0]] as int;
            return PodInt [|[val]|];
        } else {
            R:val = [args[0]] as float;
            return PodFloat [|[val]|];
        };
    }


    ("!") {
        lexical_frame.important = true;
        if args {
            lexical_frame.label = [args[0]].get_string;
        };
        return pod nil;
    }

    ("declare") {
        require in [stack] [args] all match [SymbolPattern []];
        if stack.active_error {return null#$PodVal?;};
        for $PodVal:arg in args {
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            set local var [name] in [lexical_frame] to [pod nil];
        };
        return pod nil;
    }

    ("assign") {
        require in [stack] between [2] and [2] in [args];
        require in [stack] [args[0]?] matches [SymbolPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:name = [args[0]#PodSymbol?].unwrap.str;
        $PodVal:val = args[1]; 
        set var [name] in [lexical_frame] to [val];
        return val;
    }

    ("pre") {
        given frame.data as InplaceSetBuiltinData:data {
            $PodVal:new_val = [frame.recieved].unwrap;
            set var [data.name] in [lexical_frame] to [new_val];
            return new_val;
        };
        require in [stack] between [2] and [null] in [args];
        require in [stack] [args[0]?] matches [SymbolPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:name = [args[0]#PodSymbol?].unwrap.str;
        given lookup [name] in [lexical_frame] in [stack] as $PodVal:og_val {
            frame.data = InplaceSetBuiltinData [
                name, og_val
            ];
            given make frame in [stack] of [args[1]]
                args: [[[$PodVal] [og_val]] + [[args].slice_from[2]]]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
        };
        return null#$PodVal?;
    }

    ("post") {
        given frame.data as InplaceSetBuiltinData:data {
            $PodVal:new_val = [frame.recieved].unwrap;
            set var [data.name] in [lexical_frame] to [new_val];
            return data.og_val;
        };
        require in [stack] between [2] and [null] in [args];
        require in [stack] [args[0]?] matches [SymbolPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:name = [args[0]#PodSymbol?].unwrap.str;
        given lookup [name] in [lexical_frame] in [stack] as $PodVal:og_val {
            frame.data = InplaceSetBuiltinData [
                name, og_val
            ];
            given make frame in [stack] of [args[1]]
                args: [[[$PodVal] [og_val]] + [[args].slice_from[2]]]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
        };
        return null#$PodVal?;
    }

    ("global") {
        require in [stack] between [1] and [null] in [args];
        require in [stack] [args] all match [SymbolPattern []];
        if stack.active_error {return null#$PodVal?;};
        RootPodFrame:root = [stack].get_root_frame;
        for $PodVal:arg in args {
            [root.vars].append[PodFrameVar [[arg].get_string, pod nil]];
        };
        return pod nil;
    }

    ("set") {
        require in [stack] between [3] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};

        if [args].len == 3 && ([args[0]].matches [SymbolPattern []])
            && ([args[1]].matches [ExactSymbolPattern ["="]]) {
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            if [name].at[-1] != ':' {
                set var [name]
                    in [lexical_frame]
                    to [args[2]];
                return pod nil;
            };
        };

        Bool:found_eq = false;
        [Str]:var_names = [Str] [];
        [$PodVal]:vals = [$PodVal] [];
        for $PodVal:arg in args {
            if found_eq {
                [vals].append[arg];
            } else {
                require in [stack] [arg] matches [SymbolPattern []];
                if stack.active_error {return null#$PodVal?;};
                Str:name = [arg#PodSymbol?].unwrap.str;
                if [name] equals ["="] {
                    found_eq = true;
                } else {
                    [var_names].append[name];
                };
            };
        };

        set vars [var_names] of [lexical_frame] in [stack] to [vals];

        return pod nil;
    }

    ("args") {
        require in [stack] between [1] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        require in [stack] [[args].at[-1]] matches [FnPattern []];
        if stack.active_error {return null#$PodVal?;};
        return PodBuiltinFn ["#args", args];
    }

    ("#args") {
        $PodFrame?:maybe_sub_frame = make frame in [stack]
            of [[builtin.data].at[-1]] args: [args];
        if !maybe_sub_frame {
            return null#$PodVal?;
        };
        $PodFrame:sub_frame = [maybe_sub_frame].unwrap;
        replace top of [stack] with [sub_frame];
        given sub_frame as $LexicalPodFrame:lexical_frame {
            [Str]:var_names = [Str] [];
            for $PodVal:name_val in builtin.data to [builtin.data].len-1 {
                require in [stack] [name_val] matches [SymbolPattern []];
                if stack.active_error {return null#$PodVal?;};
                [var_names].append[[name_val#PodSymbol?].unwrap.str];
            };
            set vars [var_names] of [lexical_frame] in [stack] to [args];
        } else {
            Str:msg = "Cannot set argument variables in non lexical frame";
            [stack].error["stack"][msg];
            return null#PodVal?;
        };
        return null;
    }

    ("defun") {
        require in [stack] between [2] and [2] in [args];
        require in [stack] [args[0]?] matches [SymbolPattern []];
        require in [stack] [args[1]?] matches [FnPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:name = [args[0]].get_string;
        if [name].starts_with["#"] {
            [stack].error["name"]["Function name may not start with '#'"];
            return null#PodVal?;
        };
        register fn [[args[1]#$PodFn?].unwrap]
            under [name] in [stack];
        return pod nil;
    }

    ("getfun") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:fn_name = [args[0]].get_string;
        given lookup registered fn [fn_name] in [stack] as $PodFn:fn {
            return fn;
        } else {
            return pod nil;
        };
    }

    ("errortype") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [ErrorPattern []];
        if stack.active_error {return null#$PodVal?;};
        PodError:error = [args[0]#PodError?].unwrap;
        return PodStr [error.type];
    }

    ("errormsg") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [ErrorPattern []];
        if stack.active_error {return null#$PodVal?;};
        PodError:error = [args[0]#PodError?].unwrap;
        given error.msg as Str:msg {
            return PodStr [msg];
        } else {
            return pod nil;
        };
    }

    ("errordata") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [ErrorPattern []];
        if stack.active_error {return null#$PodVal?;};
        PodError:error = [args[0]#PodError?].unwrap;
        given error.data as $PodVal:result {
            return result;
        } else {
            return pod nil;
        };
    }

    ("repr") {
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodStr [[args[0]].stringify];
    }

    ("bin") {
        return base [2] convert builtin [args] in [stack] prefix: ["0b"];
    }

    ("oct") {
        return base [8] convert builtin [args] in [stack] prefix: ["0o"];
    }

    ("hex") {
        return base [16] convert builtin [args] in [stack] prefix: ["0x"];
    }

    ("par") { // partial application
        require in [stack] between [1] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodBuiltinFn ["#par", args];
    }

    ("#par") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [[builtin.data].slice_from[1]] + [args];
        given make frame in [stack] of [fn] args: [full_args]
        as $PodFrame:sub_frame {
            replace top of [stack] with [sub_frame];
        };
        return null;
    }

    ("rpar") { // reverse partial application
        require in [stack] between [1] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodBuiltinFn ["#rpar", args];
    }

    ("#rpar") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [args] + [[builtin.data].slice_from[1]];
        given make frame in [stack] of [fn] args: [full_args]
        as $PodFrame:sub_frame {
            replace top of [stack] with [sub_frame];
        };
        return null;
    }

    ("compose") {
        require in [stack] between [1] and [null] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodBuiltinFn ["#compose", args];
    }

    ("#compose") {
        given frame.data as ComposeBuiltinData:data {
            $PodVal:val = [frame.recieved].unwrap;
            if !data.fns {
                return val;
            };
            given make frame in [stack]
                of [[data.fns].pop_end] args: [[$PodVal] [val]]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
        } else {
            frame.data = ComposeBuiltinData [builtin.data];
            given make frame in [stack]
                of [[builtin.data].pop_end] args: [args]
            as $PodFrame:sub_frame {
                [stack.frames].append[sub_frame];
            };
        };
        return null;
    }

    ("_") { // the identity function
        if args {
            return args[0];
        } else {
            return pod nil;
        };
    }

    ("C") { // creates a constant function
        require in [stack] between [1] and [1] in [args];
        if stack.active_error {return null#$PodVal?;};
        return PodBuiltinFn ["#C", args];
    }

    ("#C") {
        return builtin.data[0];
    }

    ("chr") {
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:result = [""].clone;
        for $PodVal:val in args {
            Z64:int = [val] as int;
            if (int < 0 || int > 255) {
                [stack].error["arg"]["Invalid byte value {}" % int];
                return null#PodVal?;
            };
            [result].append[int#Byte];
        };
        return PodStr [result];
    }

    ("ord") {
        require in [stack] between [1] and [1] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:str = [args[0]].get_string;
        given str[0]? as Byte:first_byte {
            return PodInt [first_byte];
        } else {
            return pod nil;
        };
    }

    ("lstrip") {
        require in [stack] between [1] and [2] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        require in [stack] [args[1]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:str = [args[0]].get_string;
        Str:chars = " \t\n\r";
        if [args].len >= 2 {
            chars = [args[1]].get_string;
        };
        str = lstrip [str] of [chars];
        return PodStr [str];
    }

    ("rstrip") {
        require in [stack] between [1] and [2] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        require in [stack] [args[1]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:str = [args[0]].get_string;
        Str:chars = " \t\n\r";
        if [args].len >= 2 {
            chars = [args[1]].get_string;
        };
        str = rstrip [str] of [chars];
        return PodStr [str];
    }

    ("strip") {
        require in [stack] between [1] and [2] in [args];
        require in [stack] [args[0]?] matches [TxtPattern []];
        require in [stack] [args[1]?] matches [TxtPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:str = [args[0]].get_string;
        Str:chars = " \t\n\r";
        if [args].len >= 2 {
            chars = [args[1]].get_string;
        };
        str = lstrip [str] of [chars];
        str = rstrip [str] of [chars];
        return PodStr [str];
    }

    ("chr") {
        require in [stack] [args] all match [IntPattern []];
        if stack.active_error {return null#$PodVal?;};
        Str:result = [""].clone;
        for $PodVal:val in args {
            Z64:int = [val] as int;
            if (int < 0 || int > 255) {
                [stack].error["arg"]["Invalid byte value {}" % int];
                return null#PodVal?;
            };
            [result].append[int#Byte];
        };
        return PodStr [result];
    };

    given run io builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run cmd builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    abort ["{} is not a builtin" % builtin.name];
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        "*",
        "/",
        "~/",
        "%",
        "^",
        ".",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",

        "str",
        "symbol",
        "float",
        "int",
        "bool",
        "arr",
        "cons",
        "list",
        "error",
        "typestr",
        "nilp",
        "nil~p",

        "forever",
        "if",
        "case",
        "while",
        "choose",
        "return",
        "break",
        "continue",
        "tailc",
        "throw",
        "try",
        "fork",

        "mkiter",
        "#resolve-iter",
        "#array-iter",
        "lenp",
        "len~p",
        "car",
        "cdr",
        "both",

        "not",
        "or",
        "and",
        "any",
        "all",
        "min",
        "max",
        "abs",
        "!",
        "declare",
        "assign",
        "pre",
        "post",
        "global",
        "set",
        "args",
        "#args",
        "defun",
        "getfun",
        "errortype",
        "errormsg",
        "errordata",
        "repr",
        "bin",
        "oct",
        "hex",
        "par",
        "#par",
        "rpar",
        "#rpar",
        "compose",
        "#compose",
        "_",
        "C",
        "#C",
        "chr",
        "ord",
        "lstrip",
        "rstrip",
        "strip",

        "print",
        "style",
        "shouldstyle",
        "inputline",
        "promptoptions",
        "getenv",
        "setenv",
        "unsetenv",
        "time",
        "unixtime",
        "perfcounter",
        "exit",
        "ep",
        "relpath",
        "fileext",
        "filestem",
        "cwd",
        "cd",
        "absp",
        "existsp",
        "filep",
        "dirp",
        "symlinkp",
        "readdir",

        "wherecmd",
        "cmd",
        "proc",
        "glob",
        "getpid",
        "getstatus",
        "getout",
        "sendin",
        "wait",
        "signalproc",
        "env",
        "capstatus",
        "cmdor",
    ];
    for Str:name in names {
        $PodFn:fn = PodBuiltinFn [name, [$PodVal] []];
        register fn [fn] under [name] in [stack];
    };
}
