%import pattern;
%import frames;
%import eval;
%import vals;

$PodVal#run builtin [PodBuiltinFn:builtin] with [[$PodVal]:args] in [PodStack:stack] {
    switch builtin.name
    ("+") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 0;
            for $PodVal:arg in args {
                x += [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 0;
            for $PodVal:arg in args {
                x += [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("-") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x -= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x -= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    (".") {
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = 1;
            for $PodVal:arg in args {
                x *= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("/") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        R:x = [args[0]] as float;
        for $PodVal:arg in args from 1 {
            x /= [arg] as float;
        };
        return PodFloat [x];
    }
    ("~/") {
        require between [1] and [null] in [args];
        require [args] all match [IntPattern []];
        Z64:x = [args[0]] as int;
        for $PodVal:arg in args from 1 {
            x = x ~/ [arg] as int;
        };
        return PodInt [x];
    }
    ("%") {
        require between [1] and [null] in [args];
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:x = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                x %= [arg] as int;
            };
            return PodInt [x];
        } else {
            R:x = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                x %= [arg] as float;
            };
            return PodFloat [x];
        };
    }
    ("<") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last < current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    (">") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last > current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    ("<=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last <= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    (">=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        require [args] all match [NumberPattern []];
        if [args].all_match[IntPattern []] {
            Z64:last = [args[0]] as int;
            for $PodVal:arg in args from 1 {
                Z64:current = [arg] as int;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        } else {
            R:last = [args[0]] as float;
            for $PodVal:arg in args from 1 {
                R:current = [arg] as float;
                if !(last >= current) {
                    return pod bool [false];
                };
                last = current;
            };
            return pod bool [true];
        };
    }
    ("=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if !([first] equals [val]) {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("!=") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if [first] equals [val] {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("is") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first != val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("isnt") {
        if [args].len <= 1 {
            return pod bool [true];
        };
        $PodVal:first = args[0];
        for $PodVal:val in args from 1 {
            if first == val {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    ("not") {
        return pod bool [![args[0]].is_truthy];
    }
    ("any") {
        for $PodVal:val in args {
            if [val].is_truthy {
                return pod bool [true];
            };
        };
        return pod bool [false];
    }
    ("all") {
        for $PodVal:val in args {
            if ![val].is_truthy {
                return pod bool [false];
            };
        };
        return pod bool [true];
    }
    // TODO: some/every are equivalent to any/all except they take
    // an iterable and (optionally) a mapping function
    ("print") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        println[result];
    }
    ("!") {
        PodFrame:frame = [stack.frames].at[-1];
        frame.important = true;
        if args {
            frame.label = [args[0]].get_string;
        };
    }
    ("forever") {
        require between [1] and [1] in [args];
        while true {
            run [args[0]] with [[$PodVal] []] in [stack];
        };
    }
    ("if") {
        require between [2] and [null] in [args];
        if [args].len > 2 {
            abort [">2 args to if not implemented"];
        };
        $PodVal:result = pod nil;
        if [args[0]].is_truthy {
            result = run [args[1]] with [[$PodVal] [args[0]]] in [stack];
        };
        return result;
    }
    ("while") {
        require between [1] and [2] in [args];
        while true {
            $PodVal:cond = run [args[0]] with [[$PodVal] []] in [stack];
            if ![cond].is_truthy {
                break;
            };
            
            if [args].len >= 2 {
                run [args[1]] with [[$PodVal] [cond]] in [stack];
            };
        };
    }
    ("inputline") {
        Str:result = [""].clone;
        for L:i enumerating args {
            if i {
                [result].append[' '];
            };
            [result].extend[[args[i]].get_string];
        };
        print[result];
        return PodStr [read_input_line];
    }
    ("str") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].get_string];
    }
    ("symbol") {
        require between [1] and [1] in [args];
        return PodSymbol [[args[0]].get_string];
    }
    ("float") {
        require between [1] and [1] in [args];
        if [args[0]].matches[NumberPattern []] {
            return PodFloat [[args[0]] as float];
        };
        given args[0] as PodStr:str {
            given parse_float[str.val] as R:val {
                return PodFloat [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to float" % [args[0]].stringify_type;
        temp error msg: [msg];
    }
    ("int") {
        require between [1] and [1] in [args];
        if [args[0]].matches[IntPattern []] {
            return PodInt [[args[0]] as int];
        } elif [args[0]].matches[NumberPattern []] {
            return PodInt [[args[0]] as float#Z64];
        };
        given args[0] as PodStr:str {
            given parse_int[str.val] as Z64:val {
                return PodInt [val];
            };
            return pod nil;
        };
        Str:msg = "Cannot convert {} to int" % [args[0]].stringify_type;
        temp error msg: [msg];
    }
    ("arr") {
        return PodArray [args];
    }
    ("cons") {
        require between [2] and [2] in [args];
        return PodPair [args[0], args[1]];
    }
    ("list") {
        $PodVal:result = pod nil;
        for $PodVal:val in args step -1 {
            result = PodPair [val, result];
        };
        return result;
    }
    ("set") {
        require between [3] and [null] in [args];

        if [args].len == 3 {
            require [args[0]] matches [SymbolPattern []];
            require [args[1]] matches [ExactSymbolPattern ["="]];
            Str:name = [args[0]#PodSymbol?].unwrap.str;
            if [name].at[-1] != '*' {
                set var [name]
                    in [[stack.frames].at[-1]]
                    to [args[2]];
                return pod nil;
            };
        };

        Str?:maybe_star_name = null;
        [Str]:pre_star_names = [Str] [];
        [Str]:post_star_names = [Str] [];
        L:required_val_count = 0;
        L:val_start_idx = 0;

        for $PodVal:arg in args {
            val_start_idx += 1;
            require [arg] matches [SymbolPattern []];
            Str:name = [arg#PodSymbol?].unwrap.str;
            if [name] equals ["="] {
                break;
            } elif [name].len == 0 {
                temp error msg: ["Cannot assign to empty symbol"];
            } elif [name].at[-1] == '*' {
                if maybe_star_name {
                    temp error msg: ["Cannot have multiple spread assignees"];
                };
                maybe_star_name = [name].slice[0][[name].len-1];
                continue;
            };
            if [name].at[-1] != '?' {
                required_val_count += 1;
            };
            if maybe_star_name {
                [post_star_names].append[name];
            } else {
                [pre_star_names].append[name];
            };
        };

        [$PodVal]:vals = [args].slice_from[val_start_idx];

        Z:optional_val_count = [vals].len#Z - (required_val_count#Z);
        if optional_val_count < 0 {
            temp error msg: ["Not enough values for all assignees"];
        };

        L:val_idx = 0;

        PodFrame:frame = [stack.frames].at[-1];
        for Str:name in pre_star_names {
            if [name].at[-1] == '?' {
                $PodVal:val = pod nil;
                if optional_val_count > 0 {
                    val = vals[val_idx];
                    val_idx += 1;
                    optional_val_count -= 1;
                };
                set var [[name].slice[0][[name].len-1]]
                    in [frame]
                    to [val];
            } else {
                set var [name]
                    in [frame]
                    to [vals[val_idx]];
                val_idx += 1;
            };
        };

        for Str:name in post_star_names step -1 {
            if [name].at[-1] == '?' {
                $PodVal:val = pod nil;
                if optional_val_count > 0 {
                    val = [vals].pop_end;
                    optional_val_count -= 1;
                };
                set var [[name].slice[0][[name].len-1]]
                    in [frame]
                    to [val];
            } else {
                set var [name]
                    in [frame]
                    to [[vals].pop_end];
            };
        };

        given maybe_star_name as Str:star_name {
            set var [star_name]
                in [frame]
                to [PodArray [[vals].slice_from[val_idx]]];
        };
    }
    ("car") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.car;
        } else {
            abort ["car with non pair not implemented"];
        };
    }
    ("cdr") {
        require between [1] and [1] in [args];
        given args[0] as PodPair:pair {
            return pair.cdr;
        } else {
            abort ["cdr with non pair not implemented"];
        };
    }
    ("defun") {
        require between [2] and [2] in [args];
        require [args[0]] matches [SymbolPattern []];
        require [args[1]] matches [FnPattern []];
        register fn [[args[1]#$PodFn?].unwrap]
            under [[args[0]].get_string]
            in [stack];
    }
    ("getfun") {
        require between [1] and [1] in [args];
        require [args[0]] matches [TxtPattern []];
        Str:fn_name = [args[0]].get_string;
        given lookup registered fn [fn_name] in [stack] as $PodFn:fn {
            return fn;
        } else {
            return pod nil;
        };
    }
    ("repr") {
        require between [1] and [1] in [args];
        return PodStr [[args[0]].stringify];
    }
    ("par") { // partial application
        require between [1] and [null] in [args];
        return PodBuiltinFn ["#par", args];
    }
    ("#par") {
        $PodVal:fn = builtin.data[0];
        [$PodVal]:full_args = [[builtin.data].slice_from[1]] + [args];
        return run [fn] with [full_args] in [stack];
    }
    ("I") { // the identity function
        require between [1] and [1] in [args];
        return args[0];
    }
    ("C") { // creates a constant function
        require between [1] and [1] in [args];
        return PodBuiltinFn ["#C", args];
    }
    ("#C") {
        return builtin.data[0];
    }
    {
        abort ["{} is not a builtin" % builtin.name];
    };
    return pod nil;
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        ".",
        "/",
        "~/",
        "%",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",
        "not",
        "any",
        "all",
        "print",
        "!",
        "forever",
        "if",
        "while",
        "inputline",
        "str",
        "symbol",
        "float",
        "int",
        "arr",
        "cons",
        "list",
        "set",
        "car",
        "cdr",
        "defun",
        "getfun",
        "repr",
        "par",
        "#par",
        "I",
        "C",
        "#C"
    ];
    for Str:name in names {
        $PodFn:fn = PodBuiltinFn [name, [$PodVal] []];
        register fn [fn] under [name] in [stack];
    };
}
