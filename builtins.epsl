%import builtins.basic;
%import builtins.datatypes;
%import builtins.flow;
%import builtins.iter;
%import builtins.misc;
%import builtins.dstr;
%import builtins.math;
%import builtins.str;
%import builtins.cmd;
%import builtins.io;
%import builtins.files;

%import pattern;
%import frames;
%import eval;
%import vals;

BuiltinSynonym {
    PodBuiltinFn:fn,
    Str:new_name
}

$PodVal?#builtin cycle of [BuiltinPodFrame:frame] in [PodStack:stack] {
    PodBuiltinFn:builtin = frame.builtin;
    [$PodVal]:args = frame.arg_vals;
    $LexicalPodFrame:lexical_frame = top lexical frame in [stack];
    
    given run basic builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run datatype builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run flow builtin [frame] in [stack] lexical: [lexical_frame]
    as $PodVal?:result {
        return result;
    };

    given run iter builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run misc builtin [frame] in [stack] lexical: [lexical_frame]
    as $PodVal?:result {
        return result;
    }

    given run dstr builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run math builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run str builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run io builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run cmd builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    given run file builtin [frame] in [stack] as $PodVal?:result {
        return result;
    };

    abort ["{} is not a builtin" % builtin.name];
}

#register builtin fns [PodStack:stack] {
    [Str]:names = [Str] [
        "+",
        "-",
        "*",
        "/",
        "~/",
        "%",
        "^",
        ".",
        "<",
        ">",
        "<=",
        ">=",
        "=",
        "!=",
        "is",
        "isnt",

        "str",
        "symbol",
        "float",
        "int",
        "bool",
        "arr",
        "tbl",
        "cons",
        "list",
        "error",
        "typestr",
        "nilp",
        "nil~p",

        "forever",
        "if",
        "case",
        "while",
        "choose",
        "return",
        "break",
        "continue",
        "tailc",
        "throw",
        "try",
        "fork",

        "mkiter",
        "lenp",
        "len~p",
        "len",
        "car",
        "cdr",
        "both",
        "range",
        "count",
        "each",
        "for",
        "map",
        "filter",
        "reduce",
        "some",
        "every",
        "includes",
        "@",
        "select",
        "reverse",
        "flat",
        "flatargs",
        "idxof",

        "not",
        "or",
        "and",
        "any",
        "all",
        "min",
        "max",
        "!",
        "declare",
        "assign",
        "pre",
        "post",
        "global",
        "set",
        "args",
        "defun",
        "getfun",
        "errortype",
        "errormsg",
        "errordata",
        "repr",
        "par",
        "rpar",
        "compose",
        "_",
        "C",

        "push",
        "put",
        "pop",
        "insert",
        "hash",
        "keys",
        "vals",
        "aitems",
        "pitems",
        "haskey",

        "round",
        "ceil",
        "floor",
        "log",
        "infp",
        "finitep",
        "abs",
        "sin",
        "cos",
        "tan",
        "asin",
        "acos",
        "atan",
        "Band",
        "Bor",
        "Bxor",
        "<<",
        ">>",
        "bin",
        "oct",
        "hex",

        "chr",
        "ord",
        "lstrip",
        "rstrip",
        "strip",
        "split",
        "join",
        "replace",
        "toupper",
        "tolower",
        "lpad",
        "rpad",
        "startswith",
        "endswith",
        "removeprefix",
        "removesuffix",

        "print",
        "style",
        "shouldstyle",
        "inputline",
        "promptoptions",
        "getenv",
        "setenv",
        "unsetenv",
        "time",
        "unixtime",
        "perfcounter",
        "exit",
        "ep",
        "relpath",
        "fileext",
        "filestem",
        "cwd",
        "cd",
        "absp",
        "existsp",
        "filep",
        "dirp",
        "symlinkp",
        "readdir",

        "wherecmd",
        "cmd",
        "proc",
        "glob",
        "getpid",
        "getstatus",
        "getout",
        "sendin",
        "wait",
        "signalproc",
        "env",
        "capstatus",
        "cmdor",

        "fopen",
        "fclose",
        "read",
        "write",
        "atEOF",
        "readlines",
        "writelines",
    ];

    for Str:name in names {
        $PodFn:fn = PodBuiltinFn [name, null];
        register fn [fn] under [name] in [stack];
    };

    [BuiltinSynonym]:synonyms = [BuiltinSynonym] [
        BuiltinSynonym [PodBuiltinFn ["arr", null], "A"],
        BuiltinSynonym [PodBuiltinFn ["args", null], "=>"],
        BuiltinSynonym [PodBuiltinFn ["flatargs", null], "flat=>"],
        BuiltinSynonym [PodBuiltinFn ["Band", null], "&"],
        BuiltinSynonym [PodBuiltinFn ["Bxor", null], "^"],
    ];

    for BuiltinSynonym:synonym in synonyms {
        register fn [synonym.fn] under [synonym.new_name] in [stack];
    };
}
