%import tokenizer;
%import parsing;
%import vals;
%import ast;

$PodExpr?#parse expr [ParseState:state] {
    W:start = [state].cur_start;
    [state].consume;
    if [state].last_id == T_CURLY_GROUP {
        return parse fn body [[state].last_substate];
    } elif [state].last_id == T_PAREN_GROUP {
        return parse S expr [[state].last_substate] outer: [false];
    } elif [state].last_id == T_INT {
        Z64:val = [[state].last_data#IntTokenData?].unwrap.val;
        return PodLiteralExpr [start, [state].last_end, PodInt [val]];
    } elif [state].last_id == T_FLOAT {
        R:val = [[state].last_data#FloatTokenData?].unwrap.val;
        return PodLiteralExpr [start, [state].last_end, PodFloat [val]];
    } elif [state].last_id == T_STR {
        Str:val = [[state].last_data#StrTokenData?].unwrap.val;
        return PodLiteralExpr [start, [state].last_end, PodStr [val]];
    } elif [state].last_id == T_SYM {
        Str:sym = [[state].last_data].read_symbol;
        W:end = [state].last_end;
        if sym[0] == '$' {
            return PodVarExpr [start, end, [sym].slice_from[1]];
        } else {
            return PodLiteralExpr [start, end, PodSymbol [sym]];
        };
    };

    [state].unconsume;
    [state].error_about_current msg: ["Expected expression"];
    return null;
}

Bool#[W:id].terminates_line {
    return id == '\n' || id == ';';
}

$PodArg?#parse cont S expr [ParseState:state] outer: [Bool:outer] {
    [state].consume; // eat the ':'
    Bool:is_spread = ![state].is_at_end && [state].cur_id == ':';
    W:spread_start = [state].cur_start;
    if is_spread {
        [state].consume; // eat the ':'
    };
    given parse S expr [state] outer: [outer] as PodSExpr:sexpr {
        if is_spread {
            return PodSpreadArg [spread_start, sexpr.end_index, sexpr];
        } else {
            return sexpr;
        };
    } else {
        return null;
    };
}

PodSExpr?#parse S expr [ParseState:state] outer: [Bool:outer] {
    W:start = [state].cur_start;
    [$PodArg]:args = [$PodArg] [];
    while ![state].is_at_end && [state].cur_id != '|' {
        if outer && [[state].cur_id].terminates_line {
            break;
        };
        if [state].cur_id == '\n' {
            [state].consume;
            continue;
        };
        Bool:is_spread = [state].cur_id == ':';
        W:spread_start = [state].cur_start;
        if is_spread {
            [state].consume; // eat the ':'
            if ![state].is_at_end && [state].cur_id == ':' {
                given parse cont S expr [state] outer: [outer]
                as $PodArg:arg {
                    [args].append[arg];
                } else {
                    return null;
                };
                break;
            };
        };
        given parse expr [state] as $PodExpr:expr {
            $PodArg:arg = expr;
            if is_spread {
                arg = PodSpreadArg [spread_start, expr.end_index, expr];
            };
            [args].append[arg];
        } else {
            return null;
        };
    };
    if !args {
        [state].error_at_current
            msg: ["Expected argument in S expression"];
        return null;
    };
    PodSExpr?:pipeline = null;
    if ![state].is_at_end && [state].cur_id == '|' {
        [state].consume; // eat the '|'
        pipeline = parse S expr [state] outer: [outer];
        if [pipeline].is_null {
            return null;
        };
    };
    return PodSExpr [start, [state].last_end, args, pipeline];
}

PodFnExpr?#parse fn body [ParseState:state] {
    W:start = [state].cur_start;

    [PodSExpr]:code = [PodSExpr] [];
    while ![state].is_at_end {
        if [[state].cur_id].terminates_line {
            [state].consume;
            continue;
        };

        Bool:is_outer = true;
        ParseState:sexpr_state = state;
        if [state].cur_id == T_PAREN_GROUP {
            [state].consume;
            if [state].is_at_end || [[state].cur_id].terminates_line {
                is_outer = false;
                sexpr_state = [state].last_substate;
            } else {
                [state].unconsume;
            };
        };

        given parse S expr [sexpr_state] outer: [is_outer]
            as PodSExpr:sexpr {
            [code].append[sexpr];
        } else {
            return null;
        };

        if [state].is_at_end {
            break;
        };
        if ![[state].cur_id].terminates_line {
            abort ["Expected token terminating line"];
        };
        [state].consume; // eat the '\n' or ';'
    };

    return PodFnExpr [start, [state].last_end, state.file, code, null];
}