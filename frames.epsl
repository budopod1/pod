%import builtinglobals;
%import builtins;
%import vals;
%import eval;

PodRegisteredFn {
    Str:name,
    $PodFn:fn
}

Redirection {
    Z64:target,
    Z64:old_fd
}

PodStack {
    [$PodFrame]:frames,
    [PodRegisteredFn]:fns,
    [Redirection]:redirections
}

PodFrameVar {
    Str:name,
    $PodVal:val
}

@super;
PodFrame {
    [$PodVal]:arg_vals,
    $PodVal?:recieved,
}

@super;
@extends PodFrame;
LexicalPodFrame {
    Bool:important,
    Str?:label,
    [PodFrameVar]:vars,
    $LexicalPodFrame?:parent
}

@extends LexicalPodFrame;
RootPodFrame {}

@extends PodFrame;
BuiltinPodFrame {
    PodBuiltinFn:builtin,
    $BuiltinData?:data
}

@super;
BuiltinData {}

@extends LexicalPodFrame;
ClearFnPodFrame {
    PodClearFn:fn,
    W:pc,
    [$PodVal]:val_stack
}

RootPodFrame#make root frame {
    return RootPodFrame [
        [$PodVal] [],
        null,
        true,
        "top",
        get builtin globals,
        null,
    ];
}

ClearFnPodFrame#make clear frame [PodClearFn:fn] args: [[$PodVal]:args] {
    return ClearFnPodFrame [
        args,
        null,
        false,
        null,
        [PodFrameVar] [],
        fn.parent_frame,
        fn,
        0,
        [$PodVal] [],
    ];
}

#register fn [$PodFn:fn] under [Str:name] in [PodStack:stack] {
    for PodRegisteredFn:registered in stack.fns {
        if [registered.name] equals [name] {
            registered.fn = fn;
            return;
        };
    };
    [stack.fns].append[PodRegisteredFn [name, fn]];
}

PodStack#make new stack {
    PodStack:stack = PodStack [
        [$PodFrame] [make root frame],
        [PodRegisteredFn] [],
        [Redirection] []
    ];
    register builtin fns [stack];
    return stack;
}

#replace top of [PodStack:stack] with [$PodFrame:frame] {
    [stack.frames].pop_end;
    [stack.frames].append[frame];
}

#pop frame in [PodStack:stack] returning [$PodVal:val] {
    [stack.frames].pop_end;
    if !stack.frames {
        abort ["Illegally popped last frame"];
    };
    [stack.frames].at[-1].recieved = val;
}

$LexicalPodFrame#top lexical frame in [PodStack:stack] {
    for $PodFrame:frame in stack.frames step -1 {
        given frame as $LexicalPodFrame:lexical_frame {
            return lexical_frame;
        };
    };
    abort ["Stack has no root frame"];
}

PodFrameVar?#get var [Str:name] in [$LexicalPodFrame:frame] {
    while true {
        for PodFrameVar:var in frame.vars {
            if [var.name] equals [name] {
                return var;
            };
        };
        given frame.parent as $LexicalPodFrame:next_frame {
            frame = next_frame;
        } else {
            return null;
        };
    };
}

$PodVal#lookup [Str:name] in [$LexicalPodFrame:frame] {
    if [name] equals ["@"] {
        return PodArray [frame.arg_vals];
    };
    given parse_int[name] as Z:i {
        if i >= 0 {
            given frame.arg_vals[i]? as $PodVal:arg {
                return arg;
            } else {
                temp error msg: ["argument index {} out of range" % i];
            };
        };
    };
    given get var [name] in [frame] as PodFrameVar:var {
        return var.val;
    } else {
        temp error msg: ["cannot find variable {}" % name];
        abort;
    };
}

#set var [Str:name] in [$LexicalPodFrame:frame] to [$PodVal:val] {
    given get var [name] in [frame] as PodFrameVar:var {
        var.val = val;
    } else {
        [frame.vars].append[PodFrameVar [name, val]];
    };
}

#set local var [Str:name] in [$LexicalPodFrame:frame] to [$PodVal:val] {
    for PodFrameVar:var in frame.vars {
        if [var.name] equals [name] {
            var.val = val;
        };
    };
    [frame.vars].append[PodFrameVar [name, val]];
}

$PodFn?#lookup registered fn [Str:name] in [PodStack:stack] {
    for PodRegisteredFn:fn in stack.fns {
        if [fn.name] equals [name] {
            return fn.fn;
        };
    };
    return null;
}
