%import builtinglobals;
%import builtins;
%import vals;
%import eval;

PodRegisteredFn {
    Str:name,
    $PodFn:fn
}

PodStack {
    [$PodFrame]:frames,
    [PodRegisteredFn]:fns,
    PodError?:active_error
}

PodFrameVar {
    Str:name,
    $PodVal:val
}

ErrorLanding {
    PodError?:caught_error
}

@super;
FrameCtx {}

#[$FrameCtx:ctx].exit stack: [PodStack:stack] {
    given ctx as RedirectionCtx:redirect_ctx {
        [redirect_ctx].exit stack: [stack];
    } given ctx as ForkChildCtx:child_ctx {
        [child_ctx].exit stack: [stack];
    } else {
        abort ["Unrecognized frame ctx {}" % ctx];
    };
}

@super;
PodFrame {
    [$PodVal]:arg_vals,
    $PodVal?:recieved,
    ErrorLanding?:landing,
    [$FrameCtx]:ctxs,
}

@super;
@extends PodFrame;
LexicalPodFrame {
    Bool:important,
    Str?:label,
    [PodFrameVar]:vars,
    $LexicalPodFrame?:parent
}

@extends LexicalPodFrame;
RootPodFrame {}

@extends PodFrame;
BuiltinPodFrame {
    PodBuiltinFn:builtin,
    $BuiltinFrameData?:data
}

@super;
BuiltinFrameData {}

@extends LexicalPodFrame;
ClearFnPodFrame {
    PodClearFn:fn,
    W:pc,
    [$PodVal]:val_stack
}

RootPodFrame#make root frame {
    return RootPodFrame [
        [$PodVal] [],        // arg_vals
        null,                // recieved
        ErrorLanding [null], // landing
        [$FrameCtx] [],      // ctxs
        true,                // important
        "top",               // label
        get builtin globals, // vars
        null,                // parent
    ];
}

ClearFnPodFrame#make clear frame [PodClearFn:fn] args: [[$PodVal]:args] {
    return ClearFnPodFrame [
        args,             // arg_vals
        null,             // recieved
        null,             // landing
        [$FrameCtx] [],   // ctxs
        false,            // important
        null,             // label
        [PodFrameVar] [], // vars
        fn.parent_frame,  // parent
        fn,               // fn
        0,                // pc
        [$PodVal] [],     // val_stack
    ];
}

BuiltinPodFrame#make builtin frame [PodBuiltinFn:fn] args: [[$PodVal]:args] {
    return BuiltinPodFrame [
        args,           // arg_vals
        null,           // recieved
        null,           // landing
        [$FrameCtx] [], // ctxs
        fn,             // builtin
        null            // data
    ];
}

#register fn [$PodFn:fn] under [Str:name] in [PodStack:stack] {
    for PodRegisteredFn:registered in stack.fns {
        if [registered.name] equals [name] {
            registered.fn = fn;
            return;
        };
    };
    [stack.fns].append[PodRegisteredFn [name, fn]];
}

PodStack#make new stack {
    PodStack:stack = PodStack [
        [$PodFrame] [make root frame],
        [PodRegisteredFn] [],
        null
    ];
    register builtin fns [stack];
    return stack;
}

RootPodFrame#[PodStack:stack].get_root_frame {
    given stack.frames[0] as RootPodFrame:root_frame {
        return root_frame;
    } else {
        abort ["Stack must have root frame"];
    };
}

#pop frame in [PodStack:stack] {
    $PodFrame:frame = [stack.frames].pop_end;
    for $FrameCtx:ctx in frame.ctxs {
        [ctx].exit stack: [stack];
    };
    if !stack.frames {
        abort ["Illegally popped last frame"];
    };
}

#replace top of [PodStack:stack] with [$PodFrame:frame] {
    pop frame in [stack];
    [stack.frames].append[frame];
}

#pop frame in [PodStack:stack] returning [$PodVal:val] {
    pop frame in [stack];
    [stack.frames].at[-1].recieved = val;
}

$LexicalPodFrame#top lexical frame in [PodStack:stack] {
    for $PodFrame:frame in stack.frames step -1 {
        given frame as $LexicalPodFrame:lexical_frame {
            return lexical_frame;
        };
    };
    abort ["Stack has no root frame"];
}

PodFrameVar?#get var [Str:name] in [$LexicalPodFrame:frame] {
    while true {
        for PodFrameVar:var in frame.vars {
            if [var.name] equals [name] {
                return var;
            };
        };
        given frame.parent as $LexicalPodFrame:next_frame {
            frame = next_frame;
        } else {
            return null;
        };
    };
}

$PodVal?#lookup [Str:name] in [$LexicalPodFrame:frame] in [PodStack:stack] {
    if [name] equals ["@"] {
        return PodArray [frame.arg_vals];
    };
    given parse_int[name] as Z:i {
        if i >= 0 {
            given frame.arg_vals[i]? as $PodVal:arg {
                return arg;
            } else {
                [stack].error["name"]["argument index {} out of range" % i];
                return null;
            };
        };
    };
    given get var [name] in [frame] as PodFrameVar:var {
        return var.val;
    } else {
        [stack].error["name"]["cannot find variable {}" % name];
        return null;
    };
}

#set var [Str:name] in [$LexicalPodFrame:frame] to [$PodVal:val] {
    given get var [name] in [frame] as PodFrameVar:var {
        var.val = val;
    } else {
        [frame.vars].append[PodFrameVar [name, val]];
    };
}

#set local var [Str:name] in [$LexicalPodFrame:frame] to [$PodVal:val] {
    for PodFrameVar:var in frame.vars {
        if [var.name] equals [name] {
            var.val = val;
        };
    };
    [frame.vars].append[PodFrameVar [name, val]];
}

$PodFn?#lookup registered fn [Str:name] in [PodStack:stack] {
    for PodRegisteredFn:fn in stack.fns {
        if [fn.name] equals [name] {
            return fn.fn;
        };
    };
    return null;
}

#[PodStack:stack].error[PodError:err] {
    stack.active_error = err;
    pop frame in [stack];
}

#[PodStack:stack].error[Str:type][Str:msg] {
    [stack].error[PodError [type, msg, null, null]];
}

PodError?#[$PodFrame:frame].consume_error {
    given frame.landing as ErrorLanding:landing {
        given landing.caught_error as PodError:error {
            landing.caught_error = null;
            return error;
        };
    };
    return null;
}
