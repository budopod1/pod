%import parseerrors;
%import fileio;
%import paths;
%import proc;

FileReadResult {
    Str?:txt,
    $ErrorBundle:errors
}

Path#pod expand path [Str:str] {
    return pod expand path [Path_from [str]];
}

Path#pod expand path [Path:path] {
    path = [path].expand_user;
    // this prevents problems like 'rm *' failing with '-.txt'
    if ![path].is_absolute && path.parts[0]? != "." {
        [path.parts].insert[0]["."];
    };
    return path;
}

Str?#lookup [Str:name] in PATH {
    Str?:maybe_PATH = get env var ["PATH"];
    if !maybe_PATH {
        return null;
    };
    Str:PATH = [maybe_PATH].unwrap;
    Path:name_path = pod expand path [name];
    for Str:part in [PATH].split[":"] {
        Path:candidate = [Path_from [part]] / [name_path];
        if [candidate].is_file {
            return [candidate].stringify;
        };
    };
    return null;
}

$ErrorBundle#IO error msg: [Str:msg] path: [Path?:maybe_path] {
    given maybe_path as Path:path {
        msg = "{}: {}" % [path].stringify % msg;
    };
    return bundle [[IOError] [IOError [
        msg, maybe_path
    ]]];
}

FileReadResult#read file [Path:path] {
    given open_file[[path].stringify][FILE_READ_MODE] as File:file {
        given [file].read_all as Str:file_text {
            return FileReadResult [file_text, bundle [[IOError] []]];
        };
    };
    return FileReadResult [null, IO error msg: ["Cannot read file"] path: [path]];
}
